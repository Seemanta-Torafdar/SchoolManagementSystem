@model IEnumerable<SchoolManagement.BLL.DTOs.Notice.NoticeDto>
@{
    ViewData["Title"] = "Faculty Circulars & Notices";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Faculty & Academic Circulars</h3>
        <p class="text-secondary small mb-0">Official institutional bulletins, committee announcements, and meeting notices.</p>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Circular Title</th>
                        <th>Category</th>
                        <th>Publish Date</th>
                        <th>Target Audience</th>
                        <th class="text-end" style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No active notices available for faculty.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var n in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@n.Title</div>
                                    @if (!string.IsNullOrEmpty(n.AttachmentUrl))
                                    {
                                        <small class="text-danger"><i class="bi bi-file-earmark-pdf me-1"></i>Attachment available</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@n.Category</span></td>
                                <td class="small text-muted">@n.PublishDate.ToString("MMMM dd, yyyy")</td>
                                <td>
                                    @if (n.IsTeacherOnly)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">Internal Faculty</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">School-Wide</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-outline-primary btn-sm">
                                        Read Notice <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
