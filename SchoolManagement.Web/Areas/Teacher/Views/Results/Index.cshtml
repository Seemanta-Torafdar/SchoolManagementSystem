@model SchoolManagement.Web.ViewModels.Result.MarksEntryFilterViewModel
@{
    ViewData["Title"] = "Faculty Marks Entry";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Marks Entry Portal</h3>
        <p class="text-secondary small mb-0">Record exam marks for your assigned subjects and sections. Grade calculations and GPA apply automatically.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter form -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select asp-for="ExaminationId" asp-items="ViewBag.Examinations" class="form-select form-select-sm" required>
                    <option value="">-- Select Examination --</option>
                </select>
            </div>
            <div class="col-md-4">
                <select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-select form-select-sm" required onchange="this.form.submit()">
                    <option value="">-- Select Assigned Subject --</option>
                </select>
            </div>
            <div class="col-md-2">
                <select asp-for="SectionId" asp-items="ViewBag.Sections" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Section --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i> Load Class
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bulk Marks Entry Table -->
@if (Model.BulkEntry != null && Model.BulkEntry.MarksEntries.Any())
{
    <form asp-action="SaveMarks" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ExaminationId" value="@Model.BulkEntry.ExaminationId" />
        <input type="hidden" name="ClassId" value="@Model.BulkEntry.ClassId" />
        <input type="hidden" name="SectionId" value="@Model.BulkEntry.SectionId" />
        <input type="hidden" name="SubjectId" value="@Model.BulkEntry.SubjectId" />

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>Enter Marks for @Model.BulkEntry.MarksEntries.Count Students
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-semibold text-muted">Max Marks:</span>
                    <input type="number" name="MaxMarks" value="@Model.BulkEntry.MaxMarks" class="form-control form-control-sm text-center" style="width: 80px;" required />
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 60px;">Roll</th>
                                <th>Student Name</th>
                                <th style="width: 160px;">Marks Obtained</th>
                                <th>Teacher Comments / Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.BulkEntry.MarksEntries.Count; i++)
                            {
                                var item = Model.BulkEntry.MarksEntries[i];
                                <tr>
                                    <td class="fw-bold">
                                        @item.RollNumber
                                        <input type="hidden" name="MarksEntries[@i].StudentId" value="@item.StudentId" />
                                        <input type="hidden" name="MarksEntries[@i].StudentName" value="@item.StudentName" />
                                        <input type="hidden" name="MarksEntries[@i].RollNumber" value="@item.RollNumber" />
                                    </td>
                                    <td class="fw-semibold text-dark">@item.StudentName</td>
                                    <td>
                                        <input type="number" step="0.5" min="0" max="100" name="MarksEntries[@i].MarksObtained" value="@item.MarksObtained" class="form-control form-control-sm fw-bold text-center" required />
                                    </td>
                                    <td>
                                        <input type="text" name="MarksEntries[@i].Remarks" value="@item.Remarks" class="form-control form-control-sm" placeholder="Optional comments..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white py-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-primary px-5 fw-semibold">
                    <i class="bi bi-check2-circle me-1"></i> Submit & Save Marks
                </button>
            </div>
        </div>
    </form>
}
else if (Model.SubjectId > 0 && Model.ExaminationId > 0)
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted">
        <i class="bi bi-people display-4 text-secondary mb-2"></i>
        <h5>No enrolled students found in this class section.</h5>
    </div>
}

