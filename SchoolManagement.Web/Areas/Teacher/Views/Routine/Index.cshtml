@model IEnumerable<SchoolManagement.BLL.DTOs.Routine.RoutineDto>
@{
    ViewData["Title"] = "My Weekly Teaching Timetable";
    var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">My Weekly Timetable</h3>
        <p class="text-secondary small mb-0">Complete weekly teaching schedule organized by day of week, periods, and room assignments.</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i> Print Timetable
    </button>
</div>

<div class="row g-4">
    @foreach (var day in days)
    {
        var slots = Model.Where(r => r.DayOfWeek.Equals(day, StringComparison.OrdinalIgnoreCase)).OrderBy(r => r.PeriodNumber).ToList();
        <div class="col-lg-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar-day me-2 text-primary"></i>@day
                    </h6>
                    <span class="badge bg-light text-muted border">@slots.Count Periods</span>
                </div>
                <div class="card-body p-3">
                    @if (!slots.Any())
                    {
                        <div class="p-4 text-center text-muted small">No class periods assigned for @day.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var slot in slots)
                            {
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-primary">Period @slot.PeriodNumber</span>
                                        <small class="text-muted fw-semibold">@slot.StartTime – @slot.EndTime</small>
                                    </div>
                                    <div class="fw-bold text-dark fs-6">@slot.SubjectName</div>
                                    <div class="small text-secondary mt-1">
                                        <i class="bi bi-mortarboard me-1"></i>Class @slot.ClassName (@slot.SectionName)
                                        @if (!string.IsNullOrEmpty(slot.RoomNumber))
                                        {
                                            <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>Room @slot.RoomNumber</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

