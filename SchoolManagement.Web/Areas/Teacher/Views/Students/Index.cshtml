@model IEnumerable<SchoolManagement.BLL.DTOs.Student.StudentDto>
@{
    ViewData["Title"] = "Assigned Class Student Roster";
    var assignedClasses = ViewBag.AssignedClasses as IEnumerable<SchoolManagement.Domain.Entities.SchoolClass> ?? Enumerable.Empty<SchoolManagement.Domain.Entities.SchoolClass>();
    var sections = ViewBag.Sections as IEnumerable<SchoolManagement.Domain.Entities.Section> ?? Enumerable.Empty<SchoolManagement.Domain.Entities.Section>();
    var selectedClassId = ViewBag.SelectedClassId as int? ?? 0;
    var selectedSectionId = ViewBag.SelectedSectionId as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Student Roster</h3>
        <p class="text-secondary small mb-0">Review student attendance lists, enrollment credentials, and guardian phone contacts.</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i> Print Roster
    </button>
</div>

<!-- Class / Section Selector -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="classId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var c in assignedClasses)
                    {
                        <option value="@c.Id" selected="@(c.Id == selectedClassId)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <select name="sectionId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var s in sections)
                    {
                        <option value="@s.Id" selected="@(s.Id == selectedSectionId)">Section @s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Load</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 60px;">Roll</th>
                        <th>Student Name</th>
                        <th>Admission No</th>
                        <th>Gender</th>
                        <th>Guardian Contact</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No enrolled students found in this section.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@s.RollNumber</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(s.PhotoUrl) ? "/images/default-avatar.png" : s.PhotoUrl)" 
                                             class="rounded-circle border" width="32" height="32" alt="@s.FullName"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@s.FullName&background=7138E8&color=fff';" />
                                        <div>
                                            <div class="fw-semibold text-dark">@s.FullName</div>
                                            <small class="text-muted">Blood: @(s.BloodGroup ?? "N/A")</small>
                                        </div>
                                    </div>
                                </td>
                                <td><code>@s.AdmissionNumber</code></td>
                                <td>@s.Gender</td>
                                <td>
                                    <a href="tel:@s.GuardianPhone" class="text-decoration-none">
                                        <i class="bi bi-telephone me-1"></i>@s.GuardianPhone
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success">@s.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

