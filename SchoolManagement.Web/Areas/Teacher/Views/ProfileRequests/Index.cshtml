@model IEnumerable<SchoolManagement.BLL.DTOs.Common.ProfileRequestDto>
@{
    ViewData["Title"] = "Official Information Change Requests";
    var teacher = ViewBag.Teacher as SchoolManagement.BLL.DTOs.Teacher.TeacherDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Official Information Change Requests</h3>
        <p class="text-secondary small mb-0">Submit amendment requests for official titles, degrees, or years of experience requiring administrative review.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newRequestModal">
        <i class="bi bi-send-plus-fill me-1"></i> New Change Request
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Date Submitted</th>
                        <th>Requested Designation</th>
                        <th>Requested Qualification</th>
                        <th>Experience</th>
                        <th>Reason Given</th>
                        <th>Status</th>
                        <th>Admin Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No profile update requests submitted yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td class="small text-muted">@req.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold text-dark">@req.RequestedDesignation</td>
                                <td>@req.RequestedQualification</td>
                                <td>@req.RequestedExperienceYears yrs</td>
                                <td class="small text-secondary text-truncate" style="max-width: 200px;">
                                    @(req.Reason ?? "N/A")
                                </td>
                                <td>
                                    @if (req.Status == SchoolManagement.Domain.Enums.RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    }
                                    else if (req.Status == SchoolManagement.Domain.Enums.RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrEmpty(req.AdminRemarks) ? "—" : req.AdminRemarks)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: New Request -->
<div class="modal fade" id="newRequestModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Submit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Submit Official Change Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        These official details will be forwarded to the Headmaster and Administrator for verification before appearing on official records.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">First Name</label>
                            <input type="text" name="RequestedFirstName" class="form-control" value="@(teacher?.FirstName)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Last Name</label>
                            <input type="text" name="RequestedLastName" class="form-control" value="@(teacher?.LastName)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Requested Designation *</label>
                            <input type="text" name="RequestedDesignation" class="form-control" value="@(teacher?.Designation)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Updated Highest Qualification *</label>
                            <input type="text" name="RequestedQualification" class="form-control" value="@(teacher?.Qualification)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Total Experience (Years) *</label>
                            <input type="number" name="RequestedExperienceYears" class="form-control" value="@(teacher?.ExperienceYears ?? 0)" min="0" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Reason for Amendment / Notes *</label>
                            <textarea name="Reason" class="form-control" rows="3" placeholder="Provide justification or certificates reference..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit to Administration</button>
                </div>
            </form>
        </div>
    </div>
</div>

