@model SchoolManagement.Web.ViewModels.Teacher.TeacherSelfProfileViewModel
@{
    ViewData["Title"] = "My Faculty Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">My Faculty Profile</h3>
        <p class="text-secondary small mb-0">Manage your contact information, biographical summary, and submit official academic amendment requests.</p>
    </div>
    <a asp-controller="ProfileRequests" asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-clock-history me-1"></i> Request Official Information Change
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="mb-3">
                <img src="@(string.IsNullOrEmpty(Model.ExistingPhotoUrl) ? "/images/default-avatar.png" : Model.ExistingPhotoUrl)" 
                     class="rounded-circle border p-1 shadow-sm" width="130" height="130" alt="@Model.FullName"
                     onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=7138E8&color=fff&size=128';" />
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
            <div class="text-muted small mb-2">@Model.Designation</div>
            <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1 mb-3">Faculty Account</span>

            <div class="bg-light p-3 rounded-3 border text-start small">
                <div class="mb-2"><strong>Qualifications:</strong> <div class="text-secondary">@Model.Qualification</div></div>
                <div class="mb-2"><strong>Teaching Experience:</strong> <span class="float-end">@Model.ExperienceYears Years</span></div>
                <div class="mb-0"><strong>Official Email:</strong> <div class="text-secondary text-truncate">@Model.Email</div></div>
            </div>

            <div class="alert alert-warning py-2 px-3 small text-start mt-3 mb-0">
                <i class="bi bi-shield-exclamation me-1"></i>
                Official details (Designation, Degree, Experience) can only be altered by School Administration via <a asp-controller="ProfileRequests" asp-action="Index">Profile Requests</a>.
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i>Edit Contact & Public Biography</h5>

            <form asp-action="UpdateContactInfo" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Designation" />
                <input type="hidden" asp-for="Qualification" />
                <input type="hidden" asp-for="ExperienceYears" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="ExistingPhotoUrl" />

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Personal Mobile Phone *</label>
                        <input asp-for="Phone" type="tel" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhotoFile" class="form-label fw-semibold">Update Profile Photo</label>
                        <input asp-for="PhotoFile" type="file" accept="image/*" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold">Residential Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label fw-semibold">Professional Bio (Displayed on Public Faculty Directory)</label>
                        <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-5 fw-semibold">
                        <i class="bi bi-check-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

