@{
    ViewData["Title"] = "System & Academic Settings";
    var sessions = ViewBag.Sessions as IEnumerable<SchoolManagement.Domain.Entities.AcademicSession> ?? Enumerable.Empty<SchoolManagement.Domain.Entities.AcademicSession>();
    var schoolSettings = ViewBag.SchoolSettings as IConfigurationSection;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">System & Academic Settings</h3>
        <p class="text-secondary small mb-0">Configure academic years/sessions, institutional parameters, and default policies.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSessionModal">
        <i class="bi bi-calendar-plus me-1"></i> Add Academic Session
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Academic Sessions Table -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-range me-2 text-primary"></i>Academic Sessions & Cohorts
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Session Name</th>
                                <th>Year</th>
                                <th>Timeline</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 130px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in sessions)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@s.SessionName</td>
                                    <td>@s.Year</td>
                                    <td class="small text-muted">@s.StartDate.ToString("MMM dd") – @s.EndDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (s.IsCurrent)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Current Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Archived</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!s.IsCurrent)
                                        {
                                            <form asp-action="SetCurrentSession" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@s.Id" />
                                                <button type="submit" class="btn btn-outline-primary btn-sm py-0 px-2" title="Activate Session">
                                                    Activate
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Institutional Settings Card -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-gear-fill me-2 text-primary"></i>Institutional Metadata
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">School Name</label>
                    <input type="text" class="form-control" value="@(schoolSettings?["SchoolName"] ?? "Ideal Residential Model High School")" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Campus Address</label>
                    <input type="text" class="form-control" value="@(schoolSettings?["Address"] ?? "Dhanmondi, Dhaka-1205")" readonly />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-semibold">Phone</label>
                        <input type="text" class="form-control" value="@(schoolSettings?["Phone"] ?? "+880 2-9876543")" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-semibold">Official Email</label>
                        <input type="text" class="form-control" value="@(schoolSettings?["Email"] ?? "info@school.edu.bd")" readonly />
                    </div>
                </div>
                <div class="alert alert-info py-2 px-3 small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Institutional metadata is managed through <code>appsettings.json</code> configuration and database properties.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create Session -->
<div class="modal fade" id="createSessionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSession" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Academic Session</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Session Name *</label>
                        <input type="text" name="sessionName" class="form-control" placeholder="e.g. Session 2027" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Academic Year *</label>
                        <input type="number" name="year" class="form-control" value="2027" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Start Date *</label>
                            <input type="date" name="startDate" class="form-control" value="2027-01-01" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">End Date *</label>
                            <input type="date" name="endDate" class="form-control" value="2027-12-31" required />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="isCurrent" value="true" class="form-check-input" id="isCurr" />
                        <label class="form-check-label fw-semibold" for="isCurr">Set as currently active academic session</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

