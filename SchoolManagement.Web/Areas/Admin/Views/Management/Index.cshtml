@model IEnumerable<SchoolManagement.Domain.Entities.ManagementMember>
@{
    ViewData["Title"] = "Governing Committee";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Governing Body & Leadership</h3>
        <p class="text-secondary small mb-0">Manage committee members, Chairman, Principal, and executive board members displayed on public site.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMemberModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add Committee Member
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Order</th>
                        <th>Member Name</th>
                        <th>Designation / Role</th>
                        <th>Contact Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No governing committee members registered.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="fw-bold">@m.DisplayOrder</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(m.PhotoUrl) ? "/images/default-avatar.png" : m.PhotoUrl)" 
                                             class="rounded-circle border" width="36" height="36" alt="@m.Name"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@m.Name&background=7138E8&color=fff';" />
                                        <span class="fw-semibold text-dark">@m.Name</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@m.Designation</span></td>
                                <td class="small text-muted">@(m.Email ?? "N/A")</td>
                                <td class="small text-muted">@(m.Phone ?? "N/A")</td>
                                <td>
                                    @if (m.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this member?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Committee Member -->
<div class="modal fade" id="addMemberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Governing Committee Member</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Full Name *</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g. Prof. Dr. A. Rahman" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Display Order *</label>
                            <input type="number" name="DisplayOrder" class="form-control" value="1" min="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Designation *</label>
                            <input type="text" name="Designation" class="form-control" placeholder="e.g. Chairman, Governing Body" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="tel" name="Phone" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Photograph</label>
                            <input type="file" name="photoFile" accept="image/*" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Chairman/Principal Welcome Message</label>
                            <textarea name="Message" class="form-control" rows="3" placeholder="Institutional vision statement..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Member</button>
                </div>
            </form>
        </div>
    </div>
</div>

