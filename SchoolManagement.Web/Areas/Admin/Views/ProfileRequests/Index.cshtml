@model IEnumerable<SchoolManagement.BLL.DTOs.Common.ProfileRequestDto>
@{
    ViewData["Title"] = "Faculty Profile Update Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Faculty Profile Update Requests</h3>
        <p class="text-secondary small mb-0">Review modifications requested by teachers for official designations, qualifications, or experience.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Date</th>
                        <th>Faculty Member</th>
                        <th>Current Information</th>
                        <th>Requested Changes</th>
                        <th>Reason / Notes</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 170px;">Review Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No profile update requests found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td class="small text-muted">@req.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold text-dark">@req.TeacherName</td>
                                <td class="small">
                                    <div><strong>Desig:</strong> @req.CurrentDesignation</div>
                                    <div><strong>Qual:</strong> @req.CurrentQualification</div>
                                    <div><strong>Exp:</strong> @req.CurrentExperienceYears yrs</div>
                                </td>
                                <td class="small bg-light-subtle">
                                    <div class="text-primary"><strong>Desig:</strong> @req.RequestedDesignation</div>
                                    <div class="text-primary"><strong>Qual:</strong> @req.RequestedQualification</div>
                                    <div class="text-primary"><strong>Exp:</strong> @req.RequestedExperienceYears yrs</div>
                                </td>
                                <td class="small text-secondary text-truncate" style="max-width: 200px;">
                                    @(string.IsNullOrEmpty(req.Reason) ? "No reason specified" : req.Reason)
                                </td>
                                <td>
                                    @if (req.Status == SchoolManagement.Domain.Enums.RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                    }
                                    else if (req.Status == SchoolManagement.Domain.Enums.RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (req.Status == SchoolManagement.Domain.Enums.RequestStatus.Pending)
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <form asp-action="Review" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <input type="hidden" name="approve" value="true" />
                                                <button type="submit" class="btn btn-outline-success" title="Approve Request">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-outline-danger" title="Reject Request" 
                                                    onclick="openRejectModal(@req.Id, '@req.TeacherName')">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Reviewed by @req.ReviewedBy</small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Reject Request -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Review" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectRequestId" />
                <input type="hidden" name="approve" value="false" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Reject Profile Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Rejecting change request for: <strong id="rejectTeacherName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Administrative Remarks / Reason</label>
                        <textarea name="adminRemarks" class="form-control" rows="3" placeholder="Provide reason for rejection..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(id, name) {
            document.getElementById('rejectRequestId').value = id;
            document.getElementById('rejectTeacherName').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }
    </script>
}

