@model IEnumerable<SchoolManagement.BLL.DTOs.Class.ClassDto>
@{
    ViewData["Title"] = "Classes & Sections Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Classes & Sections</h3>
        <p class="text-secondary small mb-0">Configure academic grades, section capacities, room numbers, and class teachers.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addClassModal">
        <i class="bi bi-plus-circle me-1"></i> Add New Class
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @foreach (var cls in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@cls.Name</h5>
                        <small class="text-muted">Numeric Grade: @cls.NumericValue</small>
                    </div>
                    <form asp-action="DeleteClass" asp-route-id="@cls.Id" method="post" onsubmit="return confirm('Delete this class and all associated data?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Class">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
                <div class="card-body p-3">
                    @if (!string.IsNullOrEmpty(cls.Description))
                    {
                        <p class="text-secondary small mb-3">@cls.Description</p>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold small text-muted text-uppercase">Assigned Sections</span>
                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" 
                                onclick="openAddSectionModal(@cls.Id, '@cls.Name')">
                            <i class="bi bi-plus"></i> Add Section
                        </button>
                    </div>

                    @if (cls.Sections != null && cls.Sections.Any())
                    {
                        <div class="list-group list-group-flush border rounded-2 small">
                            @foreach (var sec in cls.Sections)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-2">
                                    <div>
                                        <strong>Section @sec.Name</strong>
                                        <div class="text-muted" style="font-size: 0.8rem;">
                                            Cap: @sec.Capacity @(!string.IsNullOrEmpty(sec.RoomNumber) ? $"| Room: {sec.RoomNumber}" : "")
                                        </div>
                                    </div>
                                    <form asp-action="DeleteSection" asp-route-id="@sec.Id" method="post" onsubmit="return confirm('Delete section @sec.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link text-danger p-0" title="Delete Section">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small bg-light rounded">No sections added yet.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add New Class -->
<div class="modal fade" id="addClassModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateClass" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Academic Class</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Class Name *</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Class 10" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Numeric Order/Level *</label>
                        <input type="number" name="NumericValue" class="form-control" value="10" min="1" max="12" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Curriculum or notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Section -->
<div class="modal fade" id="addSectionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSection" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SchoolClassId" id="modalSectionClassId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Section to <span id="modalClassName" class="text-primary"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Section Name *</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. A, Padma, Rose" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Maximum Student Capacity</label>
                        <input type="number" name="Capacity" class="form-control" value="40" min="1" max="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Classroom / Room Number</label>
                        <input type="text" name="RoomNumber" class="form-control" placeholder="e.g. Room 302" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Section</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddSectionModal(classId, className) {
            document.getElementById('modalSectionClassId').value = classId;
            document.getElementById('modalClassName').innerText = className;
            var modal = new bootstrap.Modal(document.getElementById('addSectionModal'));
            modal.show();
        }
    </script>
}

