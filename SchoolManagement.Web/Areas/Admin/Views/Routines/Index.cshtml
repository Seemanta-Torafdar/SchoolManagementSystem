@model SchoolManagement.Web.ViewModels.Routine.RoutineListViewModel
@{
    ViewData["Title"] = "Class Timetable Routines";
    var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Class Timetable & Schedule</h3>
        <p class="text-secondary small mb-0">Master class schedules, teacher period assignments, and classroom allocations.</p>
    </div>
    <a asp-action="Create" asp-route-classId="@Model.ClassId" asp-route-sectionId="@Model.SectionId" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Timetable Period
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="classId" id="classSelect" asp-items="Model.Classes" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Select Class --</option>
                </select>
            </div>
            <div class="col-md-5">
                <select name="sectionId" asp-items="Model.Sections" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Select Section --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i> View Routine
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Routine Timetable by Day -->
<div class="row g-4">
    @foreach (var day in days)
    {
        var daySlots = Model.Routines.Where(r => r.DayOfWeek.Equals(day, StringComparison.OrdinalIgnoreCase)).OrderBy(r => r.PeriodNumber).ToList();
        <div class="col-lg-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="card-title fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar-day me-2 text-primary"></i>@day
                    </h6>
                    <span class="badge bg-light text-muted border">@daySlots.Count Periods</span>
                </div>
                <div class="card-body p-3">
                    @if (!daySlots.Any())
                    {
                        <div class="p-4 text-center text-muted small">No class periods scheduled for @day.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var slot in daySlots)
                            {
                                <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-primary">Period @slot.PeriodNumber</span>
                                            <small class="text-muted fw-semibold">@slot.StartTime – @slot.EndTime</small>
                                        </div>
                                        <div class="fw-bold text-dark fs-6">@slot.SubjectName</div>
                                        <div class="small text-secondary">
                                            <i class="bi bi-person me-1"></i>@slot.TeacherName
                                            @if (!string.IsNullOrEmpty(slot.RoomNumber))
                                            {
                                                <span class="ms-2"><i class="bi bi-geo-alt me-1"></i>Room @slot.RoomNumber</span>
                                            }
                                        </div>
                                    </div>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Remove this routine period?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <input type="hidden" name="classId" value="@Model.ClassId" />
                                        <input type="hidden" name="sectionId" value="@Model.SectionId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Remove Slot">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

