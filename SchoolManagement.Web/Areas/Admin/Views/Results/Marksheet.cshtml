@model SchoolManagement.BLL.DTOs.Result.StudentMarksheetDto
@{
    ViewData["Title"] = $"Marksheet: {Model.StudentName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Student Academic Marksheet</h3>
        <p class="text-secondary small mb-0">Examination transcript for @Model.StudentName (Roll: @Model.RollNumber, Admission: @Model.AdmissionNumber)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MarksheetPrint" asp-controller="/Results" asp-route-studentId="@Model.StudentId" asp-route-examinationId="@Model.StudentId" target="_blank" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-printer me-1"></i> Print View
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Results
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden mb-4">
    <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1 text-white fw-bold">@Model.ExaminationName</h4>
            <div class="text-white-50">Academic Session: @Model.SessionName</div>
        </div>
        <div class="text-end">
            <span class="badge @(Model.OverallGrade == "F" ? "bg-danger" : "bg-success") fs-6 px-3 py-2">
                @Model.OverallGrade (GPA: @Model.GPA.ToString("F2"))
            </span>
        </div>
    </div>

    <div class="card-body p-4 p-md-5">
        <div class="row bg-light rounded-3 p-3 mb-4">
            <div class="col-sm-6 col-md-3">
                <small class="text-muted d-block">Student Name</small>
                <span class="fw-bold fs-6">@Model.StudentName</span>
            </div>
            <div class="col-sm-6 col-md-3">
                <small class="text-muted d-block">Admission No</small>
                <span class="fw-semibold">@Model.AdmissionNumber</span>
            </div>
            <div class="col-sm-6 col-md-3">
                <small class="text-muted d-block">Class & Section</small>
                <span class="fw-semibold">@Model.ClassName (@Model.SectionName)</span>
            </div>
            <div class="col-sm-6 col-md-3">
                <small class="text-muted d-block">Class Roll</small>
                <span class="fw-bold">@Model.RollNumber</span>
            </div>
        </div>

        <div class="table-responsive mb-4">
            <table class="table table-bordered table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th class="text-start">Subject Name</th>
                        <th>Full Marks</th>
                        <th>Marks Obtained</th>
                        <th>Letter Grade</th>
                        <th>Grade Point</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.Subjects)
                    {
                        <tr>
                            <td class="fw-semibold text-muted">@sub.SubjectCode</td>
                            <td class="text-start fw-medium">@sub.SubjectName</td>
                            <td>@sub.MaxMarks</td>
                            <td class="fw-bold">@sub.MarksObtained</td>
                            <td><span class="badge @(sub.Grade == "F" ? "bg-danger" : "bg-primary")">@sub.Grade</span></td>
                            <td>@sub.GradePoint.ToString("F2")</td>
                            <td>
                                @if (sub.Status == SchoolManagement.Domain.Enums.ResultStatus.Passed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Passed</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Failed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="2" class="text-end">Grand Total:</td>
                        <td>@Model.TotalMaxMarks</td>
                        <td class="text-primary">@Model.TotalMarksObtained</td>
                        <td>@Model.OverallGrade</td>
                        <td>@Model.GPA.ToString("F2")</td>
                        <td>
                            @if (Model.ResultStatus == SchoolManagement.Domain.Enums.ResultStatus.Passed)
                            {
                                <span class="badge bg-success">PASSED</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">FAILED</span>
                            }
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

