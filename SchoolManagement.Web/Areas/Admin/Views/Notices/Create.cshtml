@model SchoolManagement.Web.ViewModels.Notice.NoticeCreateEditViewModel
@{
    ViewData["Title"] = "Post New Notice";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Create Institutional Notice</h3>
        <p class="text-secondary small mb-0">Publish a circular, exam routine, event announcement, or internal administrative notification.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Notices
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4"></div>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="Title" class="form-label fw-semibold">Notice Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="Enter clear, concise headline..." required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold">Category *</label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<SchoolManagement.Domain.Enums.NoticeType>()" class="form-select"></select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-semibold">Status *</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<SchoolManagement.Domain.Enums.NoticeStatus>()" class="form-select"></select>
                </div>

                <div class="col-md-6">
                    <label asp-for="PublishDate" class="form-label fw-semibold">Publish Date *</label>
                    <input asp-for="PublishDate" type="date" class="form-control" required />
                    <span asp-validation-for="PublishDate" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExpiryDate" class="form-label fw-semibold">Expiry Date (Optional)</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                    <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Content" class="form-label fw-semibold">Notice Content *</label>
                    <textarea asp-for="Content" rows="6" class="form-control" placeholder="Write full notice description here..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="AttachmentFile" class="form-label fw-semibold">Attach Document (PDF, DOCX, Image - Max 5MB)</label>
                    <input asp-for="AttachmentFile" type="file" class="form-control" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                    <span asp-validation-for="AttachmentFile" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-2">
                        <input asp-for="IsPublic" class="form-check-input" />
                        <label asp-for="IsPublic" class="form-check-label fw-semibold">Publish on Public Website</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-2">
                        <input asp-for="IsTeacherOnly" class="form-check-input" />
                        <label asp-for="IsTeacherOnly" class="form-check-label fw-semibold">Internal Notice (Visible to Faculty Only)</label>
                    </div>
                </div>
            </div>

            <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-5 fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Publish Notice
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

