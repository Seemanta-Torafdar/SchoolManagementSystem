@model SchoolManagement.Web.ViewModels.Notice.NoticeListViewModel
@{
    ViewData["Title"] = "Notices & Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Notices & Bulletins</h3>
        <p class="text-secondary small mb-0">Publish official institutional circulars, academic notices, and internal teacher bulletins.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-megaphone-fill me-1"></i> Post New Notice
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search notices by title or content..." />
            </div>
            <div class="col-md-3">
                <select name="category" asp-items="Html.GetEnumSelectList<SchoolManagement.Domain.Enums.NoticeType>()" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" asp-items="Html.GetEnumSelectList<SchoolManagement.Domain.Enums.NoticeStatus>()" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Publish Date</th>
                        <th>Audience</th>
                        <th>Status</th>
                        <th>Views</th>
                        <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Notices.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No notices found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Notices)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Title</div>
                                    @if (!string.IsNullOrEmpty(item.AttachmentUrl))
                                    {
                                        <small class="text-primary"><i class="bi bi-paperclip me-1"></i>Has attachment</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td class="small text-muted">@item.PublishDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (item.IsTeacherOnly)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">Faculty Only</span>
                                    }
                                    else if (item.IsPublic)
                                    {
                                        <span class="badge bg-success-subtle text-success">Public</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Internal</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == SchoolManagement.Domain.Enums.NoticeStatus.Published)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td class="small">@item.ViewCount</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this notice?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Notices.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Showing page @Model.Notices.PageIndex of @Model.Notices.TotalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.Notices.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Notices.PageIndex - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.Notices.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Notices.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.Notices.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.Notices.PageIndex + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
