@model SchoolManagement.Web.ViewModels.Student.StudentListViewModel
@{
    ViewData["Title"] = "Student Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Student Directory</h3>
        <p class="text-secondary small mb-0">Search, manage enrollments, edit credentials, and view student records.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Enroll New Student
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by name or roll..." />
            </div>
            <div class="col-md-2">
                <select name="classId" id="filterClassId" asp-items="Model.Classes" class="form-select form-select-sm">
                    <option value="">All Classes</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sectionId" id="filterSectionId" asp-items="Model.Sections" class="form-select form-select-sm">
                    <option value="">All Sections</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sessionId" asp-items="Model.Sessions" class="form-select form-select-sm">
                    <option value="">All Sessions</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 50px;">Roll</th>
                        <th>Student Name</th>
                        <th>Admission No</th>
                        <th>Class & Section</th>
                        <th>Guardian Phone</th>
                        <th>Verification PIN</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No students found matching your criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td class="fw-bold">@student.RollNumber</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(student.PhotoUrl) ? "/images/default-avatar.png" : student.PhotoUrl)" 
                                             class="rounded-circle border" width="36" height="36" alt="@student.FullName"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@student.FullName&background=7138E8&color=fff';" />
                                        <div>
                                            <div class="fw-semibold text-dark">@student.FullName</div>
                                            <div class="text-muted small">@student.Gender</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@student.AdmissionNumber</span></td>
                                <td>@student.ClassName - @student.SectionName</td>
                                <td>@student.GuardianPhone</td>
                                <td><code>@student.VerificationCode</code></td>
                                <td>
                                    @if (student.Status == SchoolManagement.Domain.Enums.StudentStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@student.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-primary" title="Edit Student">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@student.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this student?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Deactivate">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.Students.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Showing page @Model.Students.PageIndex of @Model.Students.TotalPages (@Model.Students.TotalCount total records)</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.Students.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Students.PageIndex - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-classId="@Model.ClassId" 
                           asp-route-sectionId="@Model.SectionId" 
                           asp-route-sessionId="@Model.SessionId">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.Students.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Students.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-classId="@Model.ClassId" 
                               asp-route-sectionId="@Model.SectionId" 
                               asp-route-sessionId="@Model.SessionId">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.Students.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Students.PageIndex + 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-classId="@Model.ClassId" 
                           asp-route-sectionId="@Model.SectionId" 
                           asp-route-sessionId="@Model.SessionId">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('filterClassId')?.addEventListener('change', function () {
            var classId = this.value;
            var sectionSelect = document.getElementById('filterSectionId');
            sectionSelect.innerHTML = '<option value="">All Sections</option>';

            if (classId) {
                fetch('/Admin/Students/GetSectionsByClass?classId=' + classId)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(item => {
                            var opt = document.createElement('option');
                            opt.value = item.id;
                            opt.text = item.name;
                            sectionSelect.appendChild(opt);
                        });
                    });
            }
        });
    </script>
}

