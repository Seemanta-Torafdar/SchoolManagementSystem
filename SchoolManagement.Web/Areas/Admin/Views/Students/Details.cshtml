@model SchoolManagement.BLL.DTOs.Student.StudentDto
@{
    ViewData["Title"] = $"Student Profile: {Model.FullName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Student Comprehensive Profile</h3>
        <p class="text-secondary small mb-0">Record and credentials for institutional enrollment #@Model.AdmissionNumber</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="mb-3">
                <img src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? "/images/default-avatar.png" : Model.PhotoUrl)" 
                     class="rounded-circle border p-1 shadow-sm" width="130" height="130" alt="@Model.FullName"
                     onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=7138E8&color=fff&size=128';" />
            </div>
            <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
            <div class="text-muted small mb-2">Class @Model.ClassName (Section: @Model.SectionName)</div>
            <div class="mb-3">
                @if (Model.Status == SchoolManagement.Domain.Enums.StudentStatus.Active)
                {
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-1">Active Student</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary px-3 py-1">@Model.Status</span>
                }
            </div>

            <div class="bg-light p-3 rounded-3 border text-start small">
                <div class="mb-2"><strong>Roll Number:</strong> <span class="float-end fw-bold">@Model.RollNumber</span></div>
                <div class="mb-2"><strong>Admission No:</strong> <span class="float-end text-muted">@Model.AdmissionNumber</span></div>
                <div class="mb-2"><strong>Academic Session:</strong> <span class="float-end text-muted">@Model.SessionName</span></div>
                <div class="mb-0"><strong>Verification PIN:</strong> <span class="float-end text-primary fw-bold">@Model.VerificationCode</span></div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i>Personal & Academic Records</h5>
            <table class="table table-borderless table-sm mb-4">
                <tbody>
                    <tr>
                        <th class="text-muted" style="width: 180px;">Father's Name:</th>
                        <td class="fw-semibold">@(Model.FatherName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Mother's Name:</th>
                        <td class="fw-semibold">@(Model.MotherName ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Date of Birth:</th>
                        <td>@Model.DateOfBirth.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Gender:</th>
                        <td>@Model.Gender</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Blood Group:</th>
                        <td><span class="badge bg-light text-dark border">@(Model.BloodGroup ?? "Unspecified")</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Enrollment Date:</th>
                        <td>@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</td>
                    </tr>
                </tbody>
            </table>

            <h5 class="fw-bold text-primary mb-3 border-top pt-4"><i class="bi bi-telephone-fill me-2"></i>Guardian & Address Contacts</h5>
            <table class="table table-borderless table-sm mb-0">
                <tbody>
                    <tr>
                        <th class="text-muted" style="width: 180px;">Guardian Phone:</th>
                        <td class="fw-semibold text-dark">@Model.GuardianPhone</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Guardian Email:</th>
                        <td>@(Model.GuardianEmail ?? "N/A")</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Residential Address:</th>
                        <td>@(Model.Address ?? "N/A")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

