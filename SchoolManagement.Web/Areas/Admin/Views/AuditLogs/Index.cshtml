@model IEnumerable<SchoolManagement.BLL.DTOs.Common.AuditLogDto>
@{
    ViewData["Title"] = "Security & Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Security & Audit Logs</h3>
        <p class="text-secondary small mb-0">Immutable compliance logging of administrative actions, grade entries, status modifications, and security events.</p>
    </div>
    <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-printer me-1"></i> Print Log
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 170px;">Timestamp (UTC)</th>
                        <th>User Account</th>
                        <th>Action</th>
                        <th>Entity Affected</th>
                        <th>Change Details</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No audit logs recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <span class="fw-semibold text-dark">@log.UserName</span>
                                </td>
                                <td>
                                    @if (log.Action.Contains("Delete", StringComparison.OrdinalIgnoreCase) || log.Action.Contains("Reject", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">@log.Action</span>
                                    }
                                    else if (log.Action.Contains("Create", StringComparison.OrdinalIgnoreCase) || log.Action.Contains("Publish", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">@log.Action</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary">@log.Action</span>
                                    }
                                </td>
                                <td class="fw-semibold">
                                    @log.EntityName @(!string.IsNullOrEmpty(log.EntityId) ? $"#{log.EntityId}" : "")
                                </td>
                                <td class="text-secondary" style="max-width: 320px; word-break: break-all;">
                                    @log.Details
                                </td>
                                <td><code>@(log.IpAddress ?? "Localhost")</code></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

