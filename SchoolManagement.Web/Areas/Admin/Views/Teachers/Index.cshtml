@model SchoolManagement.Web.ViewModels.Teacher.TeacherListViewModel
@{
    ViewData["Title"] = "Faculty Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Faculty & Teachers</h3>
        <p class="text-secondary small mb-0">Manage teaching staff accounts, assignments, contact details, and institutional profiles.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Add Faculty Member
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by name, email, or ID..." />
            </div>
            <div class="col-md-3">
                <select name="subjectId" asp-items="Model.Subjects" class="form-select form-select-sm">
                    <option value="">All Subjects</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active Only</option>
                    <option value="false" selected="@(Model.IsActive == false)">Inactive Only</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Teacher ID</th>
                        <th>Faculty Name</th>
                        <th>Designation</th>
                        <th>Qualifications</th>
                        <th>Contact Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Teachers.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No teachers found matching your criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var teacher in Model.Teachers)
                        {
                            <tr>
                                <td class="fw-bold">@teacher.TeacherIdNumber</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(teacher.ProfilePictureUrl) ? "/images/default-avatar.png" : teacher.ProfilePictureUrl)" 
                                             class="rounded-circle border" width="36" height="36" alt="@teacher.FullName"
                                             onerror="this.src='https://ui-avatars.com/api/?name=@teacher.FullName&background=151D35&color=fff';" />
                                        <div>
                                            <div class="fw-semibold text-dark">@teacher.FullName</div>
                                            <div class="text-muted small">@teacher.Gender</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@teacher.Designation</span></td>
                                <td class="small">@teacher.Qualification</td>
                                <td class="small">@teacher.Phone</td>
                                <td class="small">@teacher.Email</td>
                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-outline-info" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@teacher.Id" class="btn btn-outline-primary" title="Edit Teacher">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@teacher.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle active status for this teacher?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Toggle Status">
                                                <i class="bi bi-power"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Teachers.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Showing page @Model.Teachers.PageIndex of @Model.Teachers.TotalPages (@Model.Teachers.TotalCount total records)</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.Teachers.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Teachers.PageIndex - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-subjectId="@Model.SubjectId" 
                           asp-route-isActive="@Model.IsActive">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.Teachers.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Teachers.PageIndex ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@p" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-subjectId="@Model.SubjectId" 
                               asp-route-isActive="@Model.IsActive">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.Teachers.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Teachers.PageIndex + 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-subjectId="@Model.SubjectId" 
                           asp-route-isActive="@Model.IsActive">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

