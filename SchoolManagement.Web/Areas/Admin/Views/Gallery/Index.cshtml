@model IEnumerable<SchoolManagement.Domain.Entities.Gallery>
@{
    ViewData["Title"] = "Gallery Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Photo Gallery Management</h3>
        <p class="text-secondary small mb-0">Upload, categorize, and organize campus photographs for the public school website.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Photo
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm p-5 text-center text-muted">
                <i class="bi bi-images display-3 text-secondary mb-3"></i>
                <h5>No photographs uploaded to gallery yet.</h5>
            </div>
        </div>
    }
    else
    {
        @foreach (var photo in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm overflow-hidden">
                    <div style="height: 180px; overflow: hidden; background-color: #f1f3f5;">
                        <img src="@photo.ImageUrl" alt="@photo.Title" class="w-100 h-100 object-fit-cover" />
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="badge bg-light text-dark border">@photo.Category</span>
                            <small class="text-muted">@(photo.EventDate?.ToString("MMM yyyy") ?? "Campus")</small>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@photo.Title</h6>
                        <small class="text-muted flex-grow-1 text-truncate mb-2">@photo.Caption</small>
                        <form asp-action="Delete" asp-route-id="@photo.Id" method="post" onsubmit="return confirm('Delete this photo?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="bi bi-trash me-1"></i> Delete Photo
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Modal: Upload Photo -->
<div class="modal fade" id="uploadPhotoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Upload Gallery Photograph</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Photo Title *</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Science Fair 2026" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category *</label>
                        <select name="Category" class="form-select" required>
                            <option value="Campus">Campus & Infrastructure</option>
                            <option value="Events">Events & Celebrations</option>
                            <option value="Sports">Sports & Tournaments</option>
                            <option value="Academic">Academic & Laboratories</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Image File *</label>
                        <input type="file" name="imageFile" accept="image/*" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Short Caption / Description</label>
                        <textarea name="Caption" class="form-control" rows="2" placeholder="Brief note..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Upload & Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>
