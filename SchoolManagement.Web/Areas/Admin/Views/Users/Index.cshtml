@model IEnumerable<SchoolManagement.BLL.DTOs.Account.UserDto>
@{
    ViewData["Title"] = "System Users & Access Control";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Users & Access Control</h3>
        <p class="text-secondary small mb-0">Manage ASP.NET Core Identity accounts, role privileges, account lockouts, and credential resets.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Account Holder</th>
                        <th>Email / Username</th>
                        <th>Role Privileges</th>
                        <th>Registered Date</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-dark fw-bold" style="width: 36px; height: 36px;">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1))
                                    </div>
                                    <span class="fw-semibold text-dark">@user.FullName</span>
                                </div>
                            </td>
                            <td><code>@user.Email</code></td>
                            <td>
                                @if (user.Role == SchoolManagement.Domain.Enums.UserRole.Admin)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-shield-fill-check me-1"></i>Administrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary"><i class="bi bi-mortarboard-fill me-1"></i>Faculty / Teacher</span>
                                }
                            </td>
                            <td class="small text-muted">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Disabled</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" 
                                            onclick="openResetPasswordModal('@user.Id', '@user.Email')">
                                        <i class="bi bi-key me-1"></i> Reset Pass
                                    </button>

                                    <form asp-action="ToggleStatus" method="post" class="d-inline" onsubmit="return confirm('Toggle access status for this account?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Disable Account">
                                                <i class="bi bi-person-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Enable Account">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Reset Password -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Reset User Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Target Account: <strong id="resetUserEmail" class="text-dark"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Temporary Password *</label>
                        <input type="password" name="newPassword" class="form-control" placeholder="Minimum 6 characters" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply New Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openResetPasswordModal(userId, email) {
            document.getElementById('resetUserId').value = userId;
            document.getElementById('resetUserEmail').innerText = email;
            var modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            modal.show();
        }
    </script>
}

