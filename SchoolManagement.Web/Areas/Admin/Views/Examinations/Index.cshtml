@model IEnumerable<SchoolManagement.BLL.DTOs.Examination.ExaminationDto>
@{
    ViewData["Title"] = "Academic Examinations";
    var sessions = ViewBag.Sessions as IEnumerable<SchoolManagement.Domain.Entities.AcademicSession> ?? Enumerable.Empty<SchoolManagement.Domain.Entities.AcademicSession>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Academic Examinations</h3>
        <p class="text-secondary small mb-0">Schedule term examinations, configure subject criteria, and control public result publication.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createExamModal">
        <i class="bi bi-plus-circle me-1"></i> New Examination
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Examination Name</th>
                        <th>Academic Session</th>
                        <th>Timeline</th>
                        <th>Publication Status</th>
                        <th class="text-end" style="width: 280px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No examinations created yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ex in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@ex.Name</td>
                                <td><span class="badge bg-light text-dark border">@ex.SessionName</span></td>
                                <td class="small text-muted">
                                    <i class="bi bi-calendar-range me-1"></i>
                                    @ex.StartDate.ToString("MMM dd, yyyy") – @ex.EndDate.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    @if (ex.IsPublished)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Published to Public</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-lock me-1"></i>Unpublished (Draft)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="ManageSubjects" asp-route-id="@ex.Id" class="btn btn-outline-primary btn-sm" title="Subjects & Marks">
                                            <i class="bi bi-journals me-1"></i> Subjects
                                        </a>

                                        <form asp-action="TogglePublish" asp-route-id="@ex.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="publish" value="@((!ex.IsPublished).ToString().ToLower())" />
                                            @if (ex.IsPublished)
                                            {
                                                <button type="submit" class="btn btn-outline-warning btn-sm" title="Unpublish">
                                                    <i class="bi bi-eye-slash"></i> Unpublish
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Publish">
                                                    <i class="bi bi-megaphone"></i> Publish
                                                </button>
                                            }
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@ex.Id" method="post" class="d-inline" onsubmit="return confirm('Delete examination and all associated results?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Create Examination -->
<div class="modal fade" id="createExamModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create Examination Term</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Examination Title *</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Annual Examination 2026" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Academic Session *</label>
                        <select name="AcademicSessionId" class="form-select" required>
                            @foreach (var s in sessions)
                            {
                                <option value="@s.Id" selected="@s.IsCurrent">@s.SessionName (@(s.IsCurrent ? "Current" : "Historical"))</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Start Date *</label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">End Date *</label>
                            <input type="date" name="EndDate" class="form-control" value="@DateTime.UtcNow.AddDays(14).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Examination instructions or circular..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Examination</button>
                </div>
            </form>
        </div>
    </div>
</div>

