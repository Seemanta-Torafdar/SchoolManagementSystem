@model IEnumerable<SchoolManagement.Domain.Entities.Gallery>
@{
    ViewData["Title"] = "Campus Photo Gallery";
    var currentCat = ViewBag.CurrentCategory as string;
}

<section class="page-banner py-5 bg-light border-bottom">
    <div class="container">
        <h1 class="h3 fw-bold text-dark mb-1">Campus Photo Gallery</h1>
        <p class="text-secondary mb-0">Capturing vibrant moments, academic achievements, sports competitions, and campus life.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <!-- Category Filter Pills -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
            <a asp-action="Index" class="btn @(string.IsNullOrEmpty(currentCat) ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">All Photos</a>
            <a asp-action="Index" asp-route-category="Campus" class="btn @(currentCat == "Campus" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">Campus & Facility</a>
            <a asp-action="Index" asp-route-category="Events" class="btn @(currentCat == "Events" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">Events & Celebrations</a>
            <a asp-action="Index" asp-route-category="Sports" class="btn @(currentCat == "Sports" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">Sports & Activities</a>
            <a asp-action="Index" asp-route-category="Academic" class="btn @(currentCat == "Academic" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4">Academic & Science Fair</a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-images display-1 text-muted"></i>
                <h4 class="mt-3 text-secondary">No photos found in this category.</h4>
                <p class="text-muted">Please check back later or view all categories.</p>
                <a asp-action="Index" class="btn btn-outline-primary mt-2">View All Photos</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden gallery-card">
                            <div class="position-relative overflow-hidden" style="height: 220px; background-color: #e9ecef;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=600&auto=format&fit=crop&q=80" : item.ImageUrl)" 
                                     alt="@item.Title" 
                                     class="w-100 h-100 object-fit-cover transition-transform" />
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-dark bg-opacity-75">@item.Category</span>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <h6 class="card-title fw-bold text-dark mb-1">@item.Title</h6>
                                @if (!string.IsNullOrEmpty(item.Caption))
                                {
                                    <p class="card-text text-muted small text-truncate">@item.Caption</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
