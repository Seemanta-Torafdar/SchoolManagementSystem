    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Mini Admin Enrollment Chart
            var enrollCtx = document.getElementById('miniAdminEnrollChart');
            if (enrollCtx) {
                var gradient = enrollCtx.getContext('2d').createLinearGradient(0, 0, 0, 110);
                gradient.addColorStop(0, 'rgba(113, 56, 232, 0.3)');
                gradient.addColorStop(1, 'rgba(113, 56, 232, 0.0)');

                new Chart(enrollCtx, {
                    type: 'line',
                    data: {
