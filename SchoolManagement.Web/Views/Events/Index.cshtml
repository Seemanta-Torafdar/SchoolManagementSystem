@model IEnumerable<SchoolManagement.Domain.Entities.Event>
@{
    ViewData["Title"] = "School Events & Activities";
}

<section class="page-banner py-5 bg-light border-bottom">
    <div class="container">
        <h1 class="h3 fw-bold text-dark mb-1">School Events & Co-Curricular Calendar</h1>
        <p class="text-secondary mb-0">Stay updated with academic competitions, sports meets, cultural programs, and parent-teacher assemblies.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x display-1 text-muted"></i>
                <h4 class="mt-3 text-secondary">No upcoming events scheduled at this moment.</h4>
                <p class="text-muted">Please check back soon for our latest calendar updates.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ev in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden">
                            <div class="position-relative" style="height: 200px; background-color: #e9ecef;">
                                <img src="@(string.IsNullOrEmpty(ev.BannerImageUrl) ? "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&auto=format&fit=crop&q=80" : ev.BannerImageUrl)" 
                                     alt="@ev.Title" 
                                     class="w-100 h-100 object-fit-cover" />
                                <div class="position-absolute top-0 start-0 m-3 bg-primary text-white text-center rounded p-2 shadow-sm" style="min-width: 65px;">
                                    <div class="fs-4 fw-bold lh-1">@ev.EventDate.ToString("dd")</div>
                                    <div class="small text-uppercase fw-semibold">@ev.EventDate.ToString("MMM")</div>
                                </div>
                            </div>
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span>@ev.Location</span>
                                </div>
                                <h5 class="card-title fw-bold text-dark mb-2">@ev.Title</h5>
                                <p class="card-text text-secondary small flex-grow-1">
                                    @(ev.Description.Length > 120 ? ev.Description.Substring(0, 117) + "..." : ev.Description)
                                </p>
                                <div class="border-top pt-3 mt-3">
                                    <a asp-action="Details" asp-route-id="@ev.Id" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                        View Event Details <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
