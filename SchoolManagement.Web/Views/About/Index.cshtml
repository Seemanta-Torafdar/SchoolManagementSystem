@using SchoolManagement.Domain.Entities

@{
    ViewData["Title"] = "About Us";
    var members = ViewBag.ManagementMembers as IReadOnlyList<ManagementMember> ?? new List<ManagementMember>();
}

<div class="container py-5">
    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge badge-purple mb-2">Our Story &amp; Values</span>
        <h1 class="display-5 fw-bold">About Bright Future School</h1>
        <p class="text-muted fs-5">A legacy of over three decades dedicated to educational excellence, moral integrity, and social responsibility.</p>
    </div>

    <!-- History, Mission, Vision -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card p-4 h-100">
                <div class="feature-icon-wrap">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <h4 class="fw-bold mb-3">Our History</h4>
                <p class="text-muted mb-0">
                    Founded in 1994, Bright Future Model School &amp; College started with a visionary commitment to provide accessible, high-caliber education in the northern capital. Today it stands as an institution of high repute with modern infrastructure and top national rankings.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 h-100">
                <div class="feature-icon-wrap">
                    <i class="bi bi-bullseye"></i>
                </div>
                <h4 class="fw-bold mb-3">Our Mission</h4>
                <p class="text-muted mb-0">
                    To cultivate intellectual curiosity, critical inquiry, and compassionate civic responsibility in every student through evidence-based pedagogy, creative expression, and dynamic digital learning environments.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 h-100">
                <div class="feature-icon-wrap">
                    <i class="bi bi-eye-fill"></i>
                </div>
                <h4 class="fw-bold mb-3">Our Vision</h4>
                <p class="text-muted mb-0">
                    To be the foremost educational institution inspiring future leaders who shape a sustainable, equitable, and technologically advanced society through excellence, character, and service.
                </p>
            </div>
        </div>
    </div>

    <!-- School Facilities -->
    <div class="card p-5 mb-5 bg-white border-0 shadow-sm">
        <h3 class="fw-bold mb-4 text-center">World-Class Campus Facilities</h3>
        <div class="row g-4">
            <div class="col-md-3 col-6 text-center">
                <i class="bi bi-book-fill fs-1 text-purple mb-2 d-block"></i>
                <h6 class="fw-bold">Central Library</h6>
                <p class="small text-muted">Over 15,000 academic titles, periodicals, and quiet study alcoves.</p>
            </div>
            <div class="col-md-3 col-6 text-center">
                <i class="bi bi-cpu-fill fs-1 text-purple mb-2 d-block"></i>
                <h6 class="fw-bold">Computer Center</h6>
                <p class="small text-muted">Dual computer laboratories with gigabit fiber-optic connectivity.</p>
            </div>
            <div class="col-md-3 col-6 text-center">
                <i class="bi bi-lightning-charge-fill fs-1 text-purple mb-2 d-block"></i>
                <h6 class="fw-bold">Science Laboratories</h6>
                <p class="small text-muted">Fully certified physics, chemistry, and biology experimental stations.</p>
            </div>
            <div class="col-md-3 col-6 text-center">
                <i class="bi bi-shield-check fs-1 text-purple mb-2 d-block"></i>
                <h6 class="fw-bold">Safe &amp; Secure</h6>
                <p class="small text-muted">24/7 CCTV surveillance, automated access control, and dedicated security guards.</p>
            </div>
        </div>
    </div>

    <!-- School Management Committee -->
    <div class="text-center mb-4">
        <span class="badge badge-purple mb-2">Institutional Governance</span>
        <h3 class="fw-bold">Managing Committee &amp; Administration</h3>
    </div>
    <div class="row g-4 justify-content-center">
        @foreach (var member in members)
        {
            <div class="col-md-4 col-sm-6">
                <div class="card p-4 text-center h-100">
                    <img src="@(string.IsNullOrEmpty(member.PhotoUrl) ? "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=300&auto=format&fit=crop" : member.PhotoUrl)" 
                         alt="@member.Name" class="rounded-circle mx-auto mb-3 shadow-sm" style="width: 110px; height: 110px; object-fit: cover;" />
                    <h5 class="fw-bold mb-1">@member.Name</h5>
                    <span class="badge badge-purple mb-3">@member.Designation</span>
                    @if (!string.IsNullOrEmpty(member.Message))
                    {
                        <p class="small text-muted fst-italic">"@member.Message"</p>
                    }
                    @if (!string.IsNullOrEmpty(member.Email))
                    {
                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@member.Email</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

