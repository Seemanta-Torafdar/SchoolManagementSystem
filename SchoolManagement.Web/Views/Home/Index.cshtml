@using SchoolManagement.BLL.DTOs.Notice
@using SchoolManagement.BLL.DTOs.Event
@using SchoolManagement.BLL.DTOs.Teacher
@using SchoolManagement.Domain.Entities

@{
    ViewData["Title"] = "E-School - Learn With fun on any schedule";
    var latestNotices = ViewBag.LatestNotices as IReadOnlyList<NoticeDto> ?? new List<NoticeDto>();
    var upcomingEvents = ViewBag.UpcomingEvents as IReadOnlyList<EventDto> ?? new List<EventDto>();
    var teachers = ViewBag.Teachers as IReadOnlyList<TeacherDto> ?? new List<TeacherDto>();
    var management = ViewBag.ManagementMembers as IReadOnlyList<ManagementMember> ?? new List<ManagementMember>();
}

<!-- ==========================================================================
     1. HERO BANNER SECTION (Mint Green #EFFFF0 Background)
     ========================================================================== -->
<section class="es-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <!-- Welcome Orange Text -->
                <span class="es-hero-welcome">Welcome to E-School</span>

                <!-- Main Display Headline -->
                <h1 class="es-hero-title">
                    Learn With fun<br />
                    on <span class="text-es-green">any schedule</span>
                </h1>

                <!-- Subtitle -->
                <p class="es-hero-desc">
                    A modern online school platform to learn, explore, and stay connected with your classes, teachers, events, and results.
                </p>

                <!-- Blue Decorative Lines -->
                <div class="es-hero-lines">
                    <span></span>
                    <span></span>
                </div>

                <!-- CTA Button -->
                <div>
                    <a asp-area="" asp-controller="Academics" asp-action="Index" class="btn-es-green">
                        Get Started
                    </a>
                </div>
            </div>

            <!-- Right Hero Illustration -->
            <div class="col-lg-6">
                <div class="es-hero-img-wrap">
                    <svg class="es-hero-illustration" viewBox="0 0 540 380" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="teacherGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#FBBF24" />
                                <stop offset="100%" stop-color="#F59E0B" />
                            </linearGradient>
                            <linearGradient id="plantGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#34D399" />
                                <stop offset="100%" stop-color="#059669" />
                            </linearGradient>
                            <filter id="heroCardShadow" x="-10%" y="-10%" width="120%" height="120%">
                                <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#0F172A" flood-opacity="0.12" />
                            </filter>
                        </defs>

                        <!-- Background Desk Base -->
                        <rect x="220" y="270" width="300" height="12" rx="6" fill="#CBD5E0" />
                        <rect x="270" y="282" width="12" height="70" rx="3" fill="#94A3B8" />
                        <rect x="450" y="282" width="12" height="70" rx="3" fill="#94A3B8" />

                        <!-- Wall Clock (Top Left of Scene) -->
                        <circle cx="280" cy="80" r="19" fill="#FFFFFF" stroke="#06B6D4" stroke-width="4" />
                        <line x1="280" y1="80" x2="280" y2="69" stroke="#0284C7" stroke-width="3" stroke-linecap="round" />
                        <line x1="280" y1="80" x2="289" y2="80" stroke="#0284C7" stroke-width="3" stroke-linecap="round" />
                        <circle cx="280" cy="80" r="2.5" fill="#EF4444" />

                        <!-- Large Digital Screen / Virtual Classroom Monitor -->
                        <g filter="url(#heroCardShadow)">
                            <rect x="290" y="90" width="220" height="150" rx="14" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="4" />
                            <rect x="298" y="98" width="204" height="134" rx="10" fill="#F8FAFC" />
                            <!-- Video UI Bar -->
                            <rect x="298" y="98" width="204" height="24" fill="#E2E8F0" />
                            <circle cx="312" cy="110" r="4" fill="#F43F5E" />
                            <circle cx="324" cy="110" r="4" fill="#FBBF24" />
                            <circle cx="336" cy="110" r="4" fill="#10B981" />
                            <rect x="466" y="104" width="24" height="12" rx="3" fill="#EF4444" />
                            <polygon points="475,107 481,110 475,113" fill="#FFFFFF" />

                            <!-- Teacher Inside Monitor -->
                            <!-- Head & Hair -->
                            <circle cx="400" cy="140" r="18" fill="#FBD38D" />
                            <path d="M385 136 C385 124, 415 124, 415 136 Z" fill="#1E293B" />
                            <!-- Body / Yellow-Orange Shirt -->
                            <path d="M375 185 C375 160, 425 160, 425 185 Z" fill="url(#teacherGrad)" />
                            <!-- Tie -->
                            <polygon points="400,162 404,180 400,185 396,180" fill="#2563EB" />
                            <!-- Left Arm Pointing -->
                            <path d="M375 168 Q345 150 330 160" stroke="url(#teacherGrad)" stroke-width="8" stroke-linecap="round" />
                            <circle cx="328" cy="162" r="5" fill="#FBD38D" />
                            
                            <!-- Floating Virtual Content Cards on Screen -->
                            <rect x="315" y="172" width="40" height="20" rx="4" fill="#EFF6FF" stroke="#93C5FD" stroke-width="1.5" />
                            <rect x="320" y="177" width="20" height="3" rx="1.5" fill="#2563EB" />
                            <rect x="320" y="183" width="30" height="2" rx="1" fill="#94A3B8" />
                            
                            <rect x="445" y="140" width="45" height="30" rx="4" fill="#ECFDF5" stroke="#6EE7B7" stroke-width="1.5" />
                            <line x1="452" y1="150" x2="478" y2="150" stroke="#10B981" stroke-width="2" stroke-linecap="round" />
                            <line x1="452" y1="158" x2="472" y2="158" stroke="#10B981" stroke-width="2" stroke-linecap="round" />

                            <!-- Monitor Stand -->
                            <rect x="393" y="240" width="14" height="32" fill="#94A3B8" />
                            <path d="M365 272 L435 272 L440 274 L360 274 Z" fill="#64748B" />
                        </g>

                        <!-- Potted Plant on Table Stand -->
                        <g>
                            <rect x="475" y="290" width="40" height="8" rx="2" fill="#334155" />
                            <line x1="482" y1="298" x2="476" y2="352" stroke="#334155" stroke-width="4" stroke-linecap="round" />
                            <line x1="508" y1="298" x2="514" y2="352" stroke="#334155" stroke-width="4" stroke-linecap="round" />
                            <!-- Pot -->
                            <polygon points="485,290 505,290 502,268 488,268" fill="#0284C7" />
                            <ellipse cx="495" cy="268" rx="7" ry="2" fill="#0369A1" />
                            <!-- Plant Foliage -->
                            <circle cx="495" cy="254" r="14" fill="url(#plantGrad)" />
                            <circle cx="484" cy="246" r="12" fill="url(#plantGrad)" />
                            <circle cx="506" cy="246" r="12" fill="url(#plantGrad)" />
                            <circle cx="495" cy="236" r="13" fill="#6EE7B7" />
                        </g>

                        <!-- Student Learning at Desk (Left Foreground) -->
                        <g filter="url(#heroCardShadow)">
                            <!-- Chair -->
                            <rect x="180" y="210" width="34" height="42" rx="6" fill="#10B981" />
                            <path d="M174 250 L220 250 L216 262 L178 262 Z" fill="#059669" />
                            <line x1="184" y1="262" x2="176" y2="350" stroke="#334155" stroke-width="5" stroke-linecap="round" />
                            <line x1="210" y1="262" x2="224" y2="350" stroke="#334155" stroke-width="5" stroke-linecap="round" />
                            <line x1="178" y1="310" x2="220" y2="310" stroke="#64748B" stroke-width="3" />

                            <!-- Head & Hair (Student) -->
                            <circle cx="196" cy="164" r="17" fill="#FBD38D" />
                            <path d="M182 160 C182 144, 212 144, 212 160 Z" fill="#1E293B" />
                            <path d="M182 160 C172 164, 168 184, 178 188 C182 180, 184 168, 182 160 Z" fill="#1E293B" />
                            <circle cx="180" cy="168" r="3" fill="#F43F5E" />

                            <!-- Student Body / Cyan-Blue Top -->
                            <path d="M180 188 C180 178, 214 178, 214 188 L216 230 L180 230 Z" fill="#2563EB" />
                            
                            <!-- Legs & Shoes -->
                            <path d="M184 230 L226 230 L226 270 L212 270 L210 330 L198 330 L200 270 L184 270 Z" fill="#1E40AF" />
                            <ellipse cx="204" cy="334" rx="10" ry="4" fill="#F43F5E" />

                            <!-- Arms & Laptop -->
                            <path d="M198 196 Q220 216 236 218" stroke="#2563EB" stroke-width="8" stroke-linecap="round" />
                            <circle cx="238" cy="218" r="4" fill="#FBD38D" />

                            <polygon points="230,224 268,224 262,232 224,232" fill="#E2E8F0" />
                            <polygon points="244,196 272,196 268,224 240,224" fill="#334155" />
                            <polygon points="246,198 270,198 266,222 242,222" fill="#2563EB" />
                            <circle cx="256" cy="210" r="4" fill="#FFFFFF" opacity="0.8" />
                        </g>

                        <!-- Books on Table -->
                        <rect x="250" y="258" width="30" height="6" rx="1" fill="#EF4444" />
                        <rect x="252" y="252" width="28" height="6" rx="1" fill="#10B981" />
                        <rect x="254" y="246" width="24" height="6" rx="1" fill="#F59E0B" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     2. NOTICE SECTION
     ========================================================================== -->
<section class="es-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Notice</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- Main Notice Card -->
        <div class="es-notice-card">
            <div class="row align-items-center g-3">
                <!-- Megaphone Icon Column -->
                <div class="col-auto d-none d-md-block">
                    <div class="es-mega-icon">
                        <i data-lucide="megaphone" style="width:28px;height:28px;"></i>
                    </div>
                </div>

                <!-- Notices List Column -->
                <div class="col">
                    <!-- Notice 1: Urgent -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            Final Examination (Term-2) will start from 20 Nov, 2026.
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-urgent">Urgent</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:14px;height:14px;"></i> 10 Nov, 2026
                            </span>
                        </div>
                    </div>

                    <!-- Notice 2: New -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            Inter-School Science Fair Registration is Now Open.
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-new">New</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:14px;height:14px;"></i> 08 Nov, 2026
                            </span>
                        </div>
                    </div>

                    <!-- Notice 3: Info -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            School will remain closed on 16 Nov, 2026 (Victory Day).
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-info">Info</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:14px;height:14px;"></i> 05 Nov, 2026
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. TEACHER & MANAGEMENT SECTION
     ========================================================================== -->
<section class="es-section pt-0">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Teacher &amp; Management</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Teachers" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- 7 Responsive Cards Row Matching Reference Image Exactly -->
        <div class="es-team-row">
            <!-- 1. "Our Teachers" Category Badge Card -->
            <a asp-area="" asp-controller="Teachers" asp-action="Index" class="es-label-card" style="text-decoration:none;">
                <div style="background:rgba(255,255,255,0.2); border-radius:50%; width:44px; height:44px; display:flex; align-items:center; justify-content:center;">
                    <i data-lucide="users" style="width:24px;height:24px;color:#fff;"></i>
                </div>
                <span>Our<br />Teachers</span>
            </a>

            <!-- 2. Teacher 1: Md. Rahat Islam -->
            <div class="es-person-card">
                <div class="gvhs-avatar-img avatar-rahman-ali es-avatar"></div>
                <h6 class="es-person-name">Md. Rahat Islam</h6>
                <p class="es-person-sub">Mathematics</p>
            </div>

            <!-- 3. Teacher 2: Farhana Akter -->
            <div class="es-person-card">
                <div class="gvhs-avatar-img avatar-farhana-akter es-avatar"></div>
                <h6 class="es-person-name">Farhana Akter</h6>
                <p class="es-person-sub">English</p>
            </div>

            <!-- 4. Teacher 3: Sabbir Hossain -->
            <div class="es-person-card">
                <div class="gvhs-avatar-img avatar-tanvir-hasan es-avatar"></div>
                <h6 class="es-person-name">Sabbir Hossain</h6>
                <p class="es-person-sub">ICT</p>
            </div>

            <!-- 5. "Our Management" Category Badge Card -->
            <a asp-area="" asp-controller="About" asp-action="Index" class="es-label-card" style="background:#EFFFF0; color:#21B573; border:1px solid #C6F6D5; text-decoration:none;">
                <div style="background:rgba(33,181,115,0.15); border-radius:50%; width:44px; height:44px; display:flex; align-items:center; justify-content:center;">
                    <i data-lucide="landmark" style="width:24px;height:24px;color:#21B573;"></i>
                </div>
                <span style="color:#28213D;">Our<br />Management</span>
            </a>

            <!-- 6. Management 1: Prof. Dr. A. Karim -->
            <div class="es-person-card">
                <div class="gvhs-avatar-img avatar-abdur-rahman es-avatar"></div>
                <h6 class="es-person-name">Prof. Dr. A. Karim</h6>
                <p class="es-person-sub">Principal</p>
            </div>

            <!-- 7. Management 2: Nasrin Sultana -->
            <div class="es-person-card">
                <div class="gvhs-avatar-img avatar-nusrat-jahan es-avatar"></div>
                <h6 class="es-person-name">Nasrin Sultana</h6>
                <p class="es-person-sub">Vice Principal</p>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     4. NEXT EVENT SECTION
     ========================================================================== -->
<section class="es-section pt-0">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Next Event</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Events" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <!-- Left: Featured Event Details Card -->
            <div class="col-lg-4 col-md-5">
                <div class="es-event-info-card d-flex flex-column justify-content-between">
                    <div>
                        <!-- Green Date Badge -->
                        <div class="es-event-date-badge">
                            <span class="day">25</span>
                            <span class="month">Nov</span>
                        </div>
                        <h4 class="es-event-title">Annual Sports Day 2026</h4>
                        <div class="es-event-meta">
                            <i data-lucide="calendar" style="width:16px;height:16px;"></i>
                            <span>25 Nov, 2026</span>
                        </div>
                        <div class="es-event-meta">
                            <i data-lucide="map-pin" style="width:16px;height:16px;"></i>
                            <span>School Playground</span>
                        </div>
                    </div>
                    <div>
                        <a asp-area="" asp-controller="Events" asp-action="Index" class="btn-es-register">
                            Register Now &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: 3 Event Photos Grid -->
            <div class="col-lg-8 col-md-7">
                <div class="row g-3 h-100">
                    <!-- Photo 1: Athletic Sports Race -->
                    <div class="col-md-4 col-4">
                        <div class="es-event-photo h-100">
                            <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=600&q=80" 
                                 alt="Annual Sports Sprint" 
                                 loading="lazy" />
                        </div>
                    </div>
                    <!-- Photo 2: Students with Championship Trophy -->
                    <div class="col-md-4 col-4">
                        <div class="es-event-photo h-100">
                            <img src="https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=600&q=80" 
                                 alt="Trophy Celebration" 
                                 loading="lazy" />
                        </div>
                    </div>
                    <!-- Photo 3: Outdoor Stage & Canopy Ceremony -->
                    <div class="col-md-4 col-4">
                        <div class="es-event-photo h-100">
                            <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=600&q=80" 
                                 alt="Sports Ground Assembly" 
                                 loading="lazy" />
                        </div>
