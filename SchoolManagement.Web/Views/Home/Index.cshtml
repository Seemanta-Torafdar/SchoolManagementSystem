<!-- ==========================================================================
     5. CLASS VIDEOS SECTION
     ========================================================================== -->
<section class="es-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Class Videos</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Academics" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- 3 Class Video Cards -->
        <div class="row g-4">
            <!-- Video 1: Algebra - Class 10 -->
            <div class="col-lg-4 col-md-6">
                <div class="es-video-card">
                    <div class="es-video-thumb">
                        <img src="https://images.unsplash.com/photo-1635070041078-e363dbe005cb?auto=format&fit=crop&w=600&q=80" 
                             alt="Algebra Class 10" 
                             loading="lazy" />
                        <span class="es-video-chip" style="background:#10B981;">Mathematics</span>
                        <button type="button" class="es-play-btn" data-bs-toggle="modal" data-bs-target="#videoPlayerModal" data-video-title="Algebra - Class 10 (Mathematics)" aria-label="Play Algebra Class 10">
                            <i data-lucide="play" style="width:20px;height:20px;fill:currentColor;margin-left:2px;"></i>
                        </button>
                        <span class="es-duration-badge">18:24</span>
                    </div>
                    <div class="es-video-body">
                        <h5 class="es-video-title">Algebra - Class 10</h5>
                        <p class="es-video-sub mb-0 text-muted small">Chapter 4: Quadratic Equations &amp; Solutions</p>
                    </div>
                </div>
            </div>

            <!-- Video 2: Human Digestive System -->
            <div class="col-lg-4 col-md-6">
                <div class="es-video-card">
                    <div class="es-video-thumb">
                        <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=600&q=80" 
                             alt="Human Digestive System" 
                             loading="lazy" />
                        <span class="es-video-chip" style="background:#8B5CF6;">Biology</span>
                        <button type="button" class="es-play-btn" data-bs-toggle="modal" data-bs-target="#videoPlayerModal" data-video-title="Human Digestive System (Biology)" aria-label="Play Human Digestive System">
                            <i data-lucide="play" style="width:20px;height:20px;fill:currentColor;margin-left:2px;"></i>
                        </button>
                        <span class="es-duration-badge">22:10</span>
                    </div>
                    <div class="es-video-body">
                        <h5 class="es-video-title">Human Digestive System</h5>
                        <p class="es-video-sub mb-0 text-muted small">Chapter 2: Anatomy, Enzymes &amp; Metabolism</p>
                    </div>
                </div>
            </div>

            <!-- Video 3: Introduction to Programming -->
            <div class="col-lg-4 col-md-6">
                <div class="es-video-card">
                    <div class="es-video-thumb">
                        <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=600&q=80" 
                             alt="Introduction to Programming" 
                             loading="lazy" />
                        <span class="es-video-chip" style="background:#06B6D4;">ICT &amp; CS</span>
                        <button type="button" class="es-play-btn" data-bs-toggle="modal" data-bs-target="#videoPlayerModal" data-video-title="Introduction to Programming (ICT)" aria-label="Play Introduction to Programming">
                            <i data-lucide="play" style="width:20px;height:20px;fill:currentColor;margin-left:2px;"></i>
                        </button>
                        <span class="es-duration-badge">20:36</span>
                    </div>
                    <div class="es-video-body">
                        <h5 class="es-video-title">Introduction to Programming</h5>
                        <p class="es-video-sub mb-0 text-muted small">Python Basics, Variables &amp; Logic Flow</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     6. RESULT SECTION
     ========================================================================== -->
<section class="es-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Result</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Results" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- Result Lookup Box Card -->
        <div class="es-result-card">
            <div class="es-result-label">
                <div class="es-result-icon">
                    <i data-lucide="bar-chart-2" style="width:26px;height:26px;"></i>
                </div>
                <div>
                    <h5 class="es-result-text-main mb-0">Check Your Result</h5>
                    <span class="es-result-text-sub">Instant online marksheet &amp; grade</span>
                </div>
            </div>

            <form asp-area="" asp-controller="Results" asp-action="Index" method="get" class="es-result-form">
                <select name="exam" class="es-form-select" aria-label="Select Examination" required>
                    <option value="">Select Exam</option>
                    <option value="Final-2026">Final Examination 2026</option>
                    <option value="Term2-2026">Term-2 Examination 2026</option>
                    <option value="HalfYearly-2026">Half Yearly Examination</option>
                </select>

                <select name="class" class="es-form-select" aria-label="Select Class" required>
                    <option value="">Select Class</option>
                    <option value="10">Class 10</option>
                    <option value="9">Class 9</option>
                    <option value="8">Class 8</option>
                    <option value="7">Class 7</option>
                    <option value="6">Class 6</option>
                </select>

                <input type="text" name="roll" class="es-form-input" placeholder="Enter Roll Number" aria-label="Enter Roll Number" required pattern="[0-9]+" />

                <button type="submit" class="btn-es-result">
                    View Result &rarr;
                </button>
            </form>

            <div class="es-result-chips-row">
                <span class="text-muted small d-inline-flex align-items-center gap-1">
                    <i data-lucide="info" style="width:14px;height:14px;color:#10B981;"></i>
                    Enter your official 6-digit student roll number to view verified digital grade-sheet.
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Video Player Modal -->
<div class="modal fade" id="videoPlayerModal" tabindex="-1" aria-labelledby="videoPlayerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px; overflow:hidden;">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h5 class="modal-title fs-6 fw-bold" id="videoPlayerModalLabel">Class Lesson Video</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-black">
                <div class="ratio ratio-16x9">
                    <iframe id="videoPlayerIframe" src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ" title="Educational Class Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2 px-4 justify-content-between">
                <span class="small text-muted">E-School Smart Classroom Archive</span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Interactive Category Filter for Notices
        const filterBtns = document.querySelectorAll('.es-notice-filter-btn');
        const noticeRows = document.querySelectorAll('.es-notice-row-smart');

        filterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filterBtns.forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');
                noticeRows.forEach(function (row) {
                    if (filter === 'all' || row.getAttribute('data-category') === filter) {
                        row.style.display = 'flex';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });

        // 2. Video Player Modal Dynamic Title & Playback Handling
        const videoModal = document.getElementById('videoPlayerModal');
        if (videoModal) {
            videoModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (button) {
                    const title = button.getAttribute('data-video-title') || 'Class Lesson Video';
                    const modalTitle = videoModal.querySelector('.modal-title');
                    if (modalTitle) modalTitle.textContent = title;
                }
            });
            videoModal.addEventListener('hidden.bs.modal', function () {
                const iframe = document.getElementById('videoPlayerIframe');
                if (iframe) {
                    const currentSrc = iframe.src;
                    iframe.src = currentSrc; // Pause/reset video
                }
            });
        }

        // 3. Navbar Sticky Shadow on Scroll
        const header = document.querySelector('.es-navbar-wrapper');
        if (header) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 20) {
                    header.classList.add('is-scrolled');
                } else {
                    header.classList.remove('is-scrolled');
                }
            }, { passive: true });
        }

        // 4. Interactive Category Switcher for Teacher & Management
        const teamFilterBtns = document.querySelectorAll('.es-team-filter-btn');
        const teamCards = document.querySelectorAll('[data-team-group]');

        teamFilterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                teamFilterBtns.forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');

                const filter = this.getAttribute('data-team');
                teamCards.forEach(function (card) {
                    if (filter === 'all' || card.getAttribute('data-team-group') === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    });
</script>
}
