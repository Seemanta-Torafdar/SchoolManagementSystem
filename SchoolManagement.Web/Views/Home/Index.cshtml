                        </div>
                    </div>
                    <!-- Photo 3: Outdoor Stage & Canopy Ceremony -->
                    <div class="col-md-4 col-4">
                        <div class="es-event-photo h-100">
                            <img src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=600&q=80" 
                                 alt="Sports Ground Assembly" 
                                 loading="lazy" />
                            <span class="es-photo-badge" style="background:rgba(30, 144, 255, 0.9);">🎪 Pavilion</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     5. CLASS VIDEOS SECTION (Smart Video Hub with Glowing Plays)
     ========================================================================== -->
<section class="es-section es-bg-videos">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div class="es-section-title-wrap">
                <span class="es-section-pill">Interactive Learning</span>
                <h2 class="es-section-title">Class Videos</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Academics" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

