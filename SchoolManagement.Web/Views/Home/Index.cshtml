@using SchoolManagement.BLL.DTOs.Notice
@using SchoolManagement.BLL.DTOs.Event
@using SchoolManagement.BLL.DTOs.Teacher
@using SchoolManagement.Domain.Entities

@{
    ViewData["Title"] = "E-School - Learn With fun on any schedule";
    var latestNotices = ViewBag.LatestNotices as IReadOnlyList<NoticeDto> ?? new List<NoticeDto>();
    var upcomingEvents = ViewBag.UpcomingEvents as IReadOnlyList<EventDto> ?? new List<EventDto>();
    var teachers = ViewBag.Teachers as IReadOnlyList<TeacherDto> ?? new List<TeacherDto>();
    var management = ViewBag.ManagementMembers as IReadOnlyList<ManagementMember> ?? new List<ManagementMember>();
}

<!-- Ambient Background Glow Blobs for Smart Colorful Atmosphere -->
<div class="es-ambient-blob es-blob-1"></div>
<div class="es-ambient-blob es-blob-2"></div>
<div class="es-ambient-blob es-blob-3"></div>

<!-- ==========================================================================
     1. HERO BANNER SECTION (Smart, Colorful, Lush Gradient)
     ========================================================================== -->
<section class="es-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Hero Content -->
            <div class="col-lg-6">
                <!-- Welcome Pill Badge -->
                <div class="es-hero-welcome-badge">
                    <i data-lucide="sparkles" style="width:16px;height:16px;"></i>
                    <span>Welcome to E-School</span>
                </div>

                <!-- Main Display Headline -->
                <h1 class="es-hero-title">
                    Learn With fun<br />
                    on <span class="text-es-green">any schedule</span>
                </h1>

                <!-- Subtitle -->
                <p class="es-hero-desc">
                    A modern online school platform to learn, explore, and stay connected with your classes, teachers, events, and results.
                </p>

                <!-- Blue Decorative Lines -->
                <div class="es-hero-lines">
                    <span></span>
                    <span></span>
                </div>

                <!-- Dual CTA Buttons -->
                <div class="es-hero-cta-group">
                    <a asp-area="" asp-controller="Academics" asp-action="Index" class="btn-es-green">
                        Get Started <i data-lucide="arrow-right" style="width:18px;height:18px;"></i>
                    </a>
                    <a href="#result-section" class="btn-es-glass">
                        <i data-lucide="award" style="width:18px;height:18px;color:#21B573;"></i>
                        Check Result
                    </a>
                </div>
            </div>

            <!-- Right Hero Illustration with Floating Smart Badges -->
            <div class="col-lg-6">
                <div class="es-hero-img-wrap">
                    <!-- Floating Smart Badge 1 (Top Left) -->
                    <div class="es-float-badge es-badge-top-left">
                        <div class="es-badge-icon-box" style="background:linear-gradient(135deg, #F59E0B, #D97706);">
                            <i data-lucide="star" style="width:18px;height:18px;fill:#fff;"></i>
                        </div>
                        <div>
                            <div class="es-badge-text-title">Top Rated School</div>
                            <div class="es-badge-text-sub">Est. 1998 • Excellence</div>
                        </div>
                    </div>

                    <!-- Modern Educational Classroom Vector Illustration -->
                    <svg class="es-hero-illustration" viewBox="0 0 540 380" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="screenGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#2D3748" />
                                <stop offset="100%" stop-color="#1A202C" />
                            </linearGradient>
                            <linearGradient id="teacherGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#F6AD55" />
                                <stop offset="100%" stop-color="#ED8936" />
                            </linearGradient>
                            <linearGradient id="plantGrad" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#48BB78" />
                                <stop offset="100%" stop-color="#2F855A" />
                            </linearGradient>
                            <filter id="heroCardShadow" x="-10%" y="-10%" width="120%" height="120%">
                                <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#1A202C" flood-opacity="0.14" />
                            </filter>
                        </defs>

                        <!-- Background Desk Base -->
                        <rect x="220" y="270" width="300" height="12" rx="6" fill="#CBD5E0" />
                        <rect x="270" y="282" width="12" height="70" rx="3" fill="#A0AEC0" />
                        <rect x="450" y="282" width="12" height="70" rx="3" fill="#A0AEC0" />

                        <!-- Wall Clock (Top Left of Scene) -->
                        <circle cx="280" cy="80" r="18" fill="#FFFFFF" stroke="#4299E1" stroke-width="4" />
                        <line x1="280" y1="80" x2="280" y2="70" stroke="#2B6CB0" stroke-width="3" stroke-linecap="round" />
                        <line x1="280" y1="80" x2="288" y2="80" stroke="#2B6CB0" stroke-width="3" stroke-linecap="round" />
                        <circle cx="280" cy="80" r="2.5" fill="#E53E3E" />

                        <!-- Large Digital Screen / Virtual Classroom Monitor -->
                        <g filter="url(#heroCardShadow)">
                            <rect x="290" y="90" width="220" height="150" rx="14" fill="#FFFFFF" stroke="#CBD5E0" stroke-width="4" />
                            <rect x="298" y="98" width="204" height="134" rx="10" fill="#F7FAFC" />
                            <!-- Video UI Bar -->
                            <rect x="298" y="98" width="204" height="24" fill="#E2E8F0" />
                            <circle cx="312" cy="110" r="4" fill="#FC8181" />
                            <circle cx="324" cy="110" r="4" fill="#F6E05E" />
                            <circle cx="336" cy="110" r="4" fill="#68D391" />
                            <rect x="466" y="104" width="24" height="12" rx="3" fill="#E53E3E" />
                            <polygon points="475,107 481,110 475,113" fill="#FFFFFF" />

                            <!-- Teacher Inside Monitor -->
                            <!-- Head & Hair -->
                            <circle cx="400" cy="140" r="18" fill="#FBD38D" />
                            <path d="M385 136 C385 124, 415 124, 415 136 Z" fill="#2D3748" />
                            <!-- Body / Yellow-Orange Shirt -->
                            <path d="M375 185 C375 160, 425 160, 425 185 Z" fill="url(#teacherGrad)" />
                            <!-- Tie -->
                            <polygon points="400,162 404,180 400,185 396,180" fill="#2B6CB0" />
                            <!-- Left Arm Pointing -->
                            <path d="M375 168 Q345 150 330 160" stroke="url(#teacherGrad)" stroke-width="8" stroke-linecap="round" />
                            <circle cx="328" cy="162" r="5" fill="#FBD38D" />
                            
                            <!-- Floating Virtual Content Cards on Screen -->
                            <rect x="315" y="172" width="40" height="20" rx="4" fill="#EBF8FF" stroke="#BEE3F8" stroke-width="1.5" />
                            <rect x="320" y="177" width="20" height="3" rx="1.5" fill="#3182CE" />
                            <rect x="320" y="183" width="30" height="2" rx="1" fill="#A0AEC0" />
                            
                            <rect x="445" y="140" width="45" height="30" rx="4" fill="#F0FFF4" stroke="#C6F6D5" stroke-width="1.5" />
                            <line x1="452" y1="150" x2="478" y2="150" stroke="#38A169" stroke-width="2" stroke-linecap="round" />
                            <line x1="452" y1="158" x2="472" y2="158" stroke="#38A169" stroke-width="2" stroke-linecap="round" />

                            <!-- Monitor Stand -->
                            <rect x="393" y="240" width="14" height="32" fill="#A0AEC0" />
                            <path d="M365 272 L435 272 L440 274 L360 274 Z" fill="#718096" />
                        </g>

                        <!-- Potted Plant on Table Stand -->
                        <g>
                            <rect x="475" y="290" width="40" height="8" rx="2" fill="#4A5568" />
                            <line x1="482" y1="298" x2="476" y2="352" stroke="#4A5568" stroke-width="4" stroke-linecap="round" />
                            <line x1="508" y1="298" x2="514" y2="352" stroke="#4A5568" stroke-width="4" stroke-linecap="round" />
                            <!-- Pot -->
                            <polygon points="485,290 505,290 502,268 488,268" fill="#3182CE" />
                            <ellipse cx="495" cy="268" rx="7" ry="2" fill="#2B6CB0" />
                            <!-- Plant Foliage -->
                            <circle cx="495" cy="254" r="14" fill="url(#plantGrad)" />
                            <circle cx="484" cy="246" r="12" fill="url(#plantGrad)" />
                            <circle cx="506" cy="246" r="12" fill="url(#plantGrad)" />
                            <circle cx="495" cy="236" r="13" fill="#68D391" />
                        </g>

                        <!-- Student Learning at Desk (Left Foreground) -->
                        <g filter="url(#heroCardShadow)">
                            <!-- Chair -->
                            <rect x="180" y="210" width="34" height="42" rx="6" fill="#38A169" />
                            <path d="M174 250 L220 250 L216 262 L178 262 Z" fill="#276749" />
                            <line x1="184" y1="262" x2="176" y2="350" stroke="#4A5568" stroke-width="5" stroke-linecap="round" />
                            <line x1="210" y1="262" x2="224" y2="350" stroke="#4A5568" stroke-width="5" stroke-linecap="round" />
                            <line x1="178" y1="310" x2="220" y2="310" stroke="#718096" stroke-width="3" />

                            <!-- Head & Hair (Student) -->
                            <circle cx="196" cy="164" r="17" fill="#FBD38D" />
                            <path d="M182 160 C182 144, 212 144, 212 160 Z" fill="#2D3748" />
                            <path d="M182 160 C172 164, 168 184, 178 188 C182 180, 184 168, 182 160 Z" fill="#2D3748" />
                            <circle cx="180" cy="168" r="3" fill="#E53E3E" />

                            <!-- Student Body / Cyan-Blue Top -->
                            <path d="M180 188 C180 178, 214 178, 214 188 L216 230 L180 230 Z" fill="#3182CE" />
                            
                            <!-- Legs & Shoes -->
                            <path d="M184 230 L226 230 L226 270 L212 270 L210 330 L198 330 L200 270 L184 270 Z" fill="#2B6CB0" />
                            <ellipse cx="204" cy="334" rx="10" ry="4" fill="#E53E3E" />

                            <!-- Arms & Laptop -->
                            <path d="M198 196 Q220 216 236 218" stroke="#3182CE" stroke-width="8" stroke-linecap="round" />
                            <circle cx="238" cy="218" r="4" fill="#FBD38D" />

                            <polygon points="230,224 268,224 262,232 224,232" fill="#E2E8F0" />
                            <polygon points="244,196 272,196 268,224 240,224" fill="#4A5568" />
                            <polygon points="246,198 270,198 266,222 242,222" fill="#2B6CB0" />
                            <circle cx="256" cy="210" r="4" fill="#FFFFFF" opacity="0.8" />
                        </g>

                        <!-- Books on Table -->
                        <rect x="250" y="258" width="30" height="6" rx="1" fill="#E53E3E" />
                        <rect x="252" y="252" width="28" height="6" rx="1" fill="#38A169" />
                        <rect x="254" y="246" width="24" height="6" rx="1" fill="#ECC94B" />
                    </svg>

                    <!-- Floating Smart Badge 2 (Bottom Right) -->
                    <div class="es-float-badge es-badge-bottom-right">
                        <div class="es-badge-icon-box" style="background:linear-gradient(135deg, #10B981, #059669);">
                            <i data-lucide="trending-up" style="width:18px;height:18px;stroke-width:2.5;"></i>
                        </div>
                        <div>
                            <div class="es-badge-text-title">99.4% Pass Rate</div>
                            <div class="es-badge-text-sub">1,200+ Active Students</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     SMART COLORFUL METRICS STRIP (4 High-Impact Pillars)
     ========================================================================== -->
<div class="container es-stat-strip">
    <div class="es-stat-bar">
        <!-- Metric 1: Students -->
        <div class="es-stat-item">
            <div class="es-stat-icon" style="background:var(--es-mint-grad);">
                <i data-lucide="graduation-cap" style="width:26px;height:26px;"></i>
            </div>
            <div class="es-stat-info">
                <h4>1,200+</h4>
                <p>Enrolled Students</p>
            </div>
        </div>

        <!-- Metric 2: Teachers -->
        <div class="es-stat-item">
            <div class="es-stat-icon" style="background:var(--es-amber-grad);">
                <i data-lucide="users" style="width:26px;height:26px;"></i>
            </div>
            <div class="es-stat-info">
                <h4>50+</h4>
                <p>Expert Faculty</p>
            </div>
        </div>

        <!-- Metric 3: Academic Excellence -->
        <div class="es-stat-item">
            <div class="es-stat-icon" style="background:var(--es-cyan-grad);">
                <i data-lucide="award" style="width:26px;height:26px;"></i>
            </div>
            <div class="es-stat-info">
                <h4>99.2%</h4>
                <p>Academic Success</p>
            </div>
        </div>

        <!-- Metric 4: Modern Classrooms -->
        <div class="es-stat-item">
            <div class="es-stat-icon" style="background:var(--es-purple-grad);">
                <i data-lucide="monitor" style="width:26px;height:26px;"></i>
            </div>
            <div class="es-stat-info">
                <h4>100%</h4>
                <p>Digital Classrooms</p>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     2. NOTICE SECTION (Smart & Colorful Cards)
     ========================================================================== -->
<section class="es-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div class="es-section-title-wrap">
                <span class="es-section-pill">Campus Announcements</span>
                <h2 class="es-section-title">Notice</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- Main Notice Card -->
        <div class="es-notice-card">
            <div class="row align-items-center g-4">
                <!-- Megaphone Icon Column -->
                <div class="col-auto d-none d-md-block">
                    <div class="es-mega-icon">
                        <i data-lucide="megaphone" style="width:32px;height:32px;"></i>
                    </div>
                </div>

                <!-- Notices List Column -->
                <div class="col">
                    <!-- Notice 1 -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            Final Examination (Term-2) will start from 20 Nov, 2026.
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-urgent">Urgent</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:15px;height:15px;color:#DC2626;"></i> 10 Nov, 2026
                            </span>
                        </div>
                    </div>

                    <!-- Notice 2 -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            Inter-School Science Fair Registration is Now Open.
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-new">New</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:15px;height:15px;color:#047857;"></i> 08 Nov, 2026
                            </span>
                        </div>
                    </div>

                    <!-- Notice 3 -->
                    <div class="es-notice-row">
                        <div class="es-notice-icon d-md-none">
                            <i data-lucide="bell" style="width:20px;height:20px;"></i>
                        </div>
                        <h5 class="es-notice-title">
                            School will remain closed on 16 Nov, 2026 (Victory Day).
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <span class="es-badge es-badge-info">Info</span>
                            <span class="es-notice-date">
                                <i data-lucide="calendar" style="width:15px;height:15px;color:#0369A1;"></i> 05 Nov, 2026
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. TEACHER & MANAGEMENT SECTION (Vibrant Colorful Cards)
     ========================================================================== -->
<section class="es-section pt-0">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div class="es-section-title-wrap">
                <span class="es-section-pill">Academic Leadership</span>
                <h2 class="es-section-title">Teacher &amp; Management</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Teachers" asp-action="Index" class="es-view-all">
