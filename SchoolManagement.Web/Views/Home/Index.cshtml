<!-- ==========================================================================
     6. RESULT SECTION (Smart Result Verification Portal)
     ========================================================================== -->
<section class="es-section" id="result-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div class="es-section-title-wrap">
                <span class="es-section-pill">Online Verification Portal</span>
                <h2 class="es-section-title">Result</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Results" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- Result Lookup Box Card with Smart Aesthetic -->
        <div class="es-result-card">
            <div class="es-result-label">
                <div class="es-result-icon">
                    <i data-lucide="bar-chart-2" style="width:28px;height:28px;"></i>
                </div>
                <div>
                    <div class="es-result-text-main">Check Your Result</div>
                    <div class="es-result-text-sub">Instant Marksheet &amp; Grade Verification</div>
                </div>
            </div>

            <form asp-area="" asp-controller="Results" asp-action="Index" method="get" class="es-result-form">
                <select name="exam" class="es-form-select" aria-label="Select Examination">
                    <option value="">Select Exam</option>
                    <option value="Final-2026">Final Examination 2026</option>
                    <option value="Term2-2026">Term-2 Examination 2026</option>
                    <option value="HalfYearly-2026">Half Yearly Examination</option>
                </select>

                <select name="class" class="es-form-select" aria-label="Select Class">
                    <option value="">Select Class</option>
                    <option value="10">Class 10 (SSC Batch)</option>
                    <option value="9">Class 9</option>
                    <option value="8">Class 8 (JSC)</option>
                    <option value="7">Class 7</option>
                    <option value="6">Class 6</option>
                </select>

                <input type="text" name="roll" class="es-form-input" placeholder="Enter Student Roll No." aria-label="Enter Roll Number" />

                <button type="submit" class="btn-es-result">
                    <i data-lucide="search" style="width:16px;height:16px;"></i> View Result
                </button>
            </form>
        </div>
    </div>
</section>
