@using SchoolManagement.BLL.DTOs.Notice
@using SchoolManagement.BLL.DTOs.Event
@using SchoolManagement.BLL.DTOs.Teacher
@using SchoolManagement.Domain.Entities

@{
    ViewData["Title"] = "E-School - Learn With fun on any schedule";
    var latestNotices = ViewBag.LatestNotices as IReadOnlyList<NoticeDto> ?? new List<NoticeDto>();
    var upcomingEvents = ViewBag.UpcomingEvents as IReadOnlyList<EventDto> ?? new List<EventDto>();
    var teachers = ViewBag.Teachers as IReadOnlyList<TeacherDto> ?? new List<TeacherDto>();
    var management = ViewBag.ManagementMembers as IReadOnlyList<ManagementMember> ?? new List<ManagementMember>();
}

<!-- ==========================================================================
     FULL BACKGROUND SHOWCASE & QUICK ACTION NAVIGATION
     (Campus Building Full View & Glassmorphism Quick Action Buttons)
     ========================================================================== -->
<div class="es-full-bg-showcase" id="quick-actions">
    <div class="container es-showcase-container">
        <!-- Written Hero Information -->
        <div class="row align-items-center g-4 es-hero-main-row">
            <!-- Left Content: Headline, Description & CTA Buttons -->
            <div class="col-lg-7 col-xl-6">
                <!-- Main Display Headline -->
                <h1 class="es-hero-title">
                    Learn With fun<br />
                    on <span class="text-gradient-green">any schedule</span>
                </h1>

                <!-- Subtitle -->
                <p class="es-hero-desc">
                    A modern online school platform to learn, explore, and stay connected with your classes, teachers, events, and results.
                </p>

                <!-- Blue Decorative Lines -->
                <div class="es-hero-lines">
                    <span></span>
                    <span></span>
                </div>

                <!-- CTA Button Group -->
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <a asp-area="" asp-controller="Academics" asp-action="Index" class="btn-es-green">
                        Get Started
                    </a>
                    <a asp-area="" asp-controller="About" asp-action="Index" class="btn-es-glass">
                        <i data-lucide="compass" style="width:18px;height:18px;"></i> Explore Campus
                    </a>
                </div>
            </div>

            <!-- Right Area: Clear View of Campus Building & Bangladesh Flag -->
            <div class="col-lg-5 col-xl-6 d-none d-lg-block"></div>
        </div>

        <!-- Quick Action Buttons Strip (Frosted Glassmorphism Floating at Viewport Base) -->
        <div class="es-quick-actions-wrapper">
            <!-- 1. Latest Notice Button -->
            <a href="#notice-section" class="es-quick-btn es-quick-btn-notice">
                <span class="es-quick-icon">
                    <i data-lucide="bell" style="width:19px;height:19px;"></i>
                </span>
                <span>Latest Notice</span>
            </a>

            <!-- 2. Our Teacher Button -->
            <a href="#teachers-section" class="es-quick-btn es-quick-btn-teacher">
                <span class="es-quick-icon">
                    <i data-lucide="graduation-cap" style="width:19px;height:19px;"></i>
                </span>
                <span>Our Teacher</span>
            </a>

            <!-- 3. Management Button -->
            <a href="#teachers-section" class="es-quick-btn es-quick-btn-mgmt">
                <span class="es-quick-icon">
                    <i data-lucide="landmark" style="width:19px;height:19px;"></i>
                </span>
                <span>Management</span>
            </a>

            <!-- 4. Event Button -->
            <a href="#event-section" class="es-quick-btn es-quick-btn-event">
                <span class="es-quick-icon">
                    <i data-lucide="calendar" style="width:19px;height:19px;"></i>
                </span>
                <span>Event</span>
            </a>

            <!-- 5. Result Button -->
            <a href="#result-section" class="es-quick-btn es-quick-btn-result">
                <span class="es-quick-icon">
                    <i data-lucide="award" style="width:19px;height:19px;"></i>
                </span>
                <span>Result</span>
            </a>

            <!-- 6. Academic Calendar Button -->
            <a asp-area="" asp-controller="Academics" asp-action="Index" class="es-quick-btn es-quick-btn-calendar">
                <span class="es-quick-icon">
                    <i data-lucide="calendar-days" style="width:19px;height:19px;"></i>
                </span>
                <span>Academic Calendar</span>
            </a>
        </div>
    </div>
</div>

<!-- ==========================================================================
     2. NOTICE SECTION (Smart & Attractive Announcement Board)
     ========================================================================== -->
<section class="es-section" id="notice-section">
    <div class="container">
        <!-- Section Header -->
        <div class="es-section-header">
            <div>
                <h2 class="es-section-title">Notice</h2>
            </div>
            <div>
                <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-view-all">
                    View All &rarr;
                </a>
            </div>
        </div>

        <!-- Scroll-Driven Expanding Card Stage (NSU Motion Style) -->
        <div class="es-notice-expand-stage" id="noticeExpandStage">
            <div class="es-notice-expand-card" id="noticeExpandCard">
                <!-- Main Notice Card -->
                <div class="es-notice-card">
            <!-- Live Announcement Moving Ticker (Continuous motion banner) -->
            <div class="es-notice-live-ticker">
                <span class="es-ticker-badge">
                    <span class="es-ticker-dot"></span> LIVE
                </span>
                <div class="es-ticker-track-wrap">
                    <span class="es-ticker-track">
                        📌 Term-2 Final Examination routine published &bull; 🔴 Admit cards collection starts from Nov 20 &bull; 🟢 Inter-School Science Fair registration open &bull; 🔵 Campus Victory Day observance notice
                    </span>
                </div>
            </div>

            <!-- Filter Pills -->
            <div class="es-notice-filter-pills">
                <button type="button" class="es-notice-filter-btn active" data-filter="all">📌 All Circulars</button>
                <button type="button" class="es-notice-filter-btn" data-filter="exam">🔴 Examinations</button>
                <button type="button" class="es-notice-filter-btn" data-filter="academic">🟢 Academic &amp; Fair</button>
                <button type="button" class="es-notice-filter-btn" data-filter="holiday">🔵 Holidays &amp; Events</button>
            </div>

            <!-- Notices List -->
            <div class="es-notices-list">
                @if (latestNotices != null && latestNotices.Any())
                {
                    @foreach (var notice in latestNotices.Take(4))
                    {
                        var catLower = notice.Category.ToString().ToLower();
                        var categoryClass = catLower switch {
                            "urgent" or "exam" => "es-notice-row-urgent",
                            "academic" => "es-notice-row-new",
                            _ => "es-notice-row-info"
                        };
                        var badgeClass = catLower switch {
                            "urgent" or "exam" => "es-badge-urgent",
                            "academic" => "es-badge-new",
                            _ => "es-badge-info"
                        };
                        var filterCat = catLower switch {
                            "urgent" or "exam" => "exam",
                            "academic" => "academic",
                            _ => "holiday"
                        };
                        <div class="es-notice-row-smart @categoryClass" data-category="@filterCat">
                            <div class="es-notice-date-box">
                                <span class="day">@notice.PublishDate.ToString("dd")</span>
                                <span class="month">@notice.PublishDate.ToString("MMM")</span>
                            </div>
                            <div class="es-notice-content">
                                <h5>@notice.Title</h5>
                                <p class="es-notice-desc">@(string.IsNullOrWhiteSpace(notice.Content) ? "Click details to read full circular." : (notice.Content.Length > 90 ? notice.Content.Substring(0, 90) + "..." : notice.Content))</p>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="es-badge @badgeClass">@notice.Category.ToString()</span>
                                <a asp-area="" asp-controller="Notices" asp-action="Details" asp-route-id="@notice.Id" class="es-notice-action-link">
                                    Details &rarr;
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Notice 1: Urgent / Exam -->
                    <div class="es-notice-row-smart es-notice-row-urgent" data-category="exam">
                        <div class="es-notice-date-box">
                            <span class="day">20</span>
                            <span class="month">Nov</span>
                        </div>
                        <div class="es-notice-content">
                            <h5>Final Examination (Term-2) will start from 20 Nov, 2026.</h5>
                            <p class="es-notice-desc">All students of Class 6–10 must collect their Term-2 admit cards from their class teachers.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-1 small d-inline-flex align-items-center gap-1" style="font-size:0.72rem;"><i data-lucide="paperclip" style="width:11px;height:11px;"></i> PDF</span>
                            <span class="es-badge es-badge-urgent">Urgent</span>
                            <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-notice-action-link">
                                Details &rarr;
                            </a>
                        </div>
                    </div>

                    <!-- Notice 2: New / Academic -->
                    <div class="es-notice-row-smart es-notice-row-new" data-category="academic">
                        <div class="es-notice-date-box">
                            <span class="day">08</span>
                            <span class="month">Nov</span>
                        </div>
                        <div class="es-notice-content">
                            <h5>Inter-School Science Fair Registration is Now Open.</h5>
                            <p class="es-notice-desc">Annual science exhibition project submission deadline is 15 Nov. Lab guides available.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-1 small d-inline-flex align-items-center gap-1" style="font-size:0.72rem;"><i data-lucide="paperclip" style="width:11px;height:11px;"></i> Guidelines</span>
                            <span class="es-badge es-badge-new">New</span>
                            <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-notice-action-link">
                                Details &rarr;
                            </a>
                        </div>
                    </div>

                    <!-- Notice 3: Info / Holiday -->
                    <div class="es-notice-row-smart es-notice-row-info" data-category="holiday">
                        <div class="es-notice-date-box">
                            <span class="day">05</span>
                            <span class="month">Nov</span>
                        </div>
                        <div class="es-notice-content">
                            <h5>School will remain closed on 16 Nov, 2026 (Victory Day).</h5>
                            <p class="es-notice-desc">Campus administrative offices and classes will resume on Tuesday, 17 Nov at 8:00 AM.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="es-badge es-badge-info">Info</span>
                            <a asp-area="" asp-controller="Notices" asp-action="Index" class="es-notice-action-link">
                                Details &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
            </div>
        </div>
    </div>
</section>

