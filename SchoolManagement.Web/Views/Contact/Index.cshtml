@{
    ViewData["Title"] = "Contact Us";
}

<section class="page-banner py-5 bg-light border-bottom">
    <div class="container">
        <h1 class="h3 fw-bold text-dark mb-1">Contact School Administration</h1>
        <p class="text-secondary mb-0">Have inquiries regarding admissions, academics, or facilities? Get in touch with our administrative office.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Contact Info -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm h-100 p-4">
                    <h4 class="fw-bold text-dark mb-4">Institutional Contacts</h4>

                    <div class="d-flex gap-3 mb-4">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px;">
                            <i class="bi bi-geo-alt-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Campus Address</div>
                            <div class="text-muted small">House #12, Road #4, Dhanmondi R/A, Dhaka-1205, Bangladesh</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px;">
                            <i class="bi bi-telephone-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Telephone & Helpline</div>
                            <div class="text-muted small">+880 2-9876543 (Main Office)</div>
                            <div class="text-muted small">+880 1711-000000 (Admission Helpline)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px;">
                            <i class="bi bi-envelope-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Official Email Addresses</div>
                            <div class="text-muted small">info@school.edu.bd (General Inquiries)</div>
                            <div class="text-muted small">admission@school.edu.bd (Admissions)</div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; min-width: 48px;">
                            <i class="bi bi-clock-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold">Visiting & Office Hours</div>
                            <div class="text-muted small">Sunday – Thursday: 8:00 AM – 3:30 PM</div>
                            <div class="text-muted small">Friday – Saturday: Closed</div>
                        </div>
                    </div>

                    <!-- Map Frame -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="rounded-3 overflow-hidden border" style="height: 200px;">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3652.2274488277254!2d90.37298637533549!3d23.739261878679095!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755b8b7a55cd9bd%3A0x208890f50ad33940!2sDhanmondi%2C%20Dhaka!5e0!3m2!1sen!2sbd!4v1700000000000!5m2!1sen!2sbd" 
                                    width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-4 p-md-5">
                    <h4 class="fw-bold text-dark mb-1">Send Us a Direct Message</h4>
                    <p class="text-muted small mb-4">Please fill out this form and our academic reception office will respond within 24 business hours.</p>

                    <form asp-action="SubmitMessage" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Your Full Name *</label>
                                <input type="text" name="name" class="form-control" placeholder="e.g. Mohammad Ali" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email Address *</label>
                                <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" placeholder="+880 1XXXXXXXXX" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Subject *</label>
                                <input type="text" name="subject" class="form-control" placeholder="Admission / Academic Inquiry" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Message Description *</label>
                                <textarea name="message" class="form-control" rows="5" placeholder="Write your inquiry details here..." required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold">
                                    <i class="bi bi-send me-2"></i>Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

