@{
    ViewData["Title"] = "Access Denied";
}

<section class="py-5 bg-light min-vh-75 d-flex align-items-center">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-5">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-x display-1"></i>
                    </div>
                    <h2 class="fw-bold text-dark mb-2">Access Denied (403)</h2>
                    <p class="text-secondary mb-4">
                        You do not possess the required institutional authorization or role privilege to view or perform actions on this restricted resource.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                            <i class="bi bi-house-door me-1"></i> Return Home
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                            Switch Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

