@model SchoolManagement.Web.ViewModels.Result.PublicResultSearchViewModel
@{
    ViewData["Title"] = "Academic Examination Results";
}

<section class="page-banner py-5 bg-light border-bottom">
    <div class="container">
        <h1 class="h3 fw-bold text-dark mb-1">Academic Examination Results</h1>
        <p class="text-secondary mb-0">Search and verify individual student term marksheets with official verification credentials.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <!-- Search Card -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-search me-2"></i>Marksheet Search Portal</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-4">
                            <i class="bi bi-shield-lock-fill text-primary fs-5 me-2"></i>
                            <div>To safeguard student privacy and prevent unauthenticated data enumeration, entering the <strong>Private Verification PIN</strong> found on the student admit card / ID card is required.</div>
                        </div>

                        <form asp-action="Index" method="post" class="needs-validation">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="ExaminationId" class="form-label fw-semibold">Examination</label>
                                    <select asp-for="ExaminationId" asp-items="Model.Examinations" class="form-select" required>
                                        <option value="">-- Select Examination --</option>
                                    </select>
                                    <span asp-validation-for="ExaminationId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="AcademicSessionId" class="form-label fw-semibold">Academic Session</label>
                                    <select asp-for="AcademicSessionId" asp-items="Model.Sessions" class="form-select" required>
                                        <option value="">-- Select Session --</option>
                                    </select>
                                    <span asp-validation-for="AcademicSessionId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="ClassId" class="form-label fw-semibold">Class</label>
                                    <select asp-for="ClassId" asp-items="Model.Classes" class="form-select" required>
                                        <option value="">-- Select Class --</option>
                                    </select>
                                    <span asp-validation-for="ClassId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="RollNumber" class="form-label fw-semibold">Class Roll Number</label>
                                    <input asp-for="RollNumber" type="number" class="form-control" placeholder="e.g. 1" required min="1" />
                                    <span asp-validation-for="RollNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="VerificationCode" class="form-label fw-semibold">Verification PIN</label>
                                    <input asp-for="VerificationCode" class="form-control" placeholder="e.g. STU-2026-001" required />
                                    <span asp-validation-for="VerificationCode" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-4 text-center">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold">
                                    <i class="bi bi-file-earmark-check me-2"></i>Search Marksheet
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Marksheet Result Card -->
        @if (Model.Marksheet != null)
        {
            var sheet = Model.Marksheet;
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card shadow border-0 overflow-hidden">
                        <div class="card-header bg-dark text-white p-4 d-flex flex-wrap justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-1 text-white fw-bold">PROGRESS REPORT & ACADEMIC TRANSCRIPT</h4>
                                <div class="text-white-50">@sheet.ExaminationName — @sheet.SessionName</div>
                            </div>
                            <div class="mt-2 mt-md-0">
                                <a asp-action="MarksheetPrint" asp-route-studentId="@sheet.StudentId" asp-route-examinationId="@Model.ExaminationId" target="_blank" class="btn btn-light btn-sm fw-semibold">
                                    <i class="bi bi-printer me-1"></i> Print / Save PDF
                                </a>
                            </div>
                        </div>

                        <div class="card-body p-4 p-md-5">
                            <!-- Student Info Section -->
                            <div class="row bg-light rounded-3 p-4 mb-4 align-items-center">
                                <div class="col-md-8">
                                    <table class="table table-borderless table-sm mb-0">
                                        <tbody>
                                            <tr>
                                                <th class="ps-0 text-muted" style="width: 150px;">Student Name:</th>
                                                <td class="fw-bold fs-5 text-dark">@sheet.StudentName</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 text-muted">Admission No:</th>
                                                <td class="fw-semibold">@sheet.AdmissionNumber</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 text-muted">Class & Section:</th>
                                                <td class="fw-semibold">@sheet.ClassName (Section: @sheet.SectionName)</td>
                                            </tr>
                                            <tr>
                                                <th class="ps-0 text-muted">Class Roll:</th>
                                                <td class="fw-semibold">@sheet.RollNumber</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-md-4 text-center mt-3 mt-md-0">
                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="small text-muted mb-1">Overall GPA</div>
                                        <div class="display-6 fw-bold text-primary">@sheet.GPA.ToString("F2")</div>
                                        <span class="badge @(sheet.OverallGrade == "F" ? "bg-danger" : "bg-success") px-3 py-1 fs-6">Grade: @sheet.OverallGrade</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Subject Marks Table -->
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered table-hover align-middle">
                                    <thead class="table-light text-center">
                                        <tr>
                                            <th>Code</th>
                                            <th class="text-start">Subject Name</th>
                                            <th>Full Marks</th>
                                            <th>Marks Obtained</th>
                                            <th>Grade</th>
                                            <th>Grade Point</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sub in sheet.Subjects)
                                        {
                                            <tr class="text-center">
                                                <td class="fw-semibold text-muted">@sub.SubjectCode</td>
                                                <td class="text-start fw-medium">@sub.SubjectName</td>
                                                <td>@sub.MaxMarks</td>
                                                <td class="fw-bold">@sub.MarksObtained</td>
                                                <td><span class="badge @(sub.Grade == "F" ? "bg-danger" : "bg-primary")">@sub.Grade</span></td>
                                                <td>@sub.GradePoint.ToString("F2")</td>
                                                <td>
                                                    @if (sub.Status == SchoolManagement.Domain.Enums.ResultStatus.Passed)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Passed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Failed</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold text-center">
                                        <tr>
                                            <td colspan="2" class="text-end">Total:</td>
                                            <td>@sheet.TotalMaxMarks</td>
                                            <td class="text-primary">@sheet.TotalMarksObtained</td>
                                            <td>@sheet.OverallGrade</td>
                                            <td>@sheet.GPA.ToString("F2")</td>
                                            <td>
                                                @if (sheet.ResultStatus == SchoolManagement.Domain.Enums.ResultStatus.Passed)
                                                {
                                                    <span class="badge bg-success">PASSED</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">FAILED</span>
                                                }
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- Footer note -->
                            <div class="text-muted small text-center mt-3">
                                <em>This is a system-generated result sheet from the School Management System. Official physical certificate will be issued by the Head of Institution.</em>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

