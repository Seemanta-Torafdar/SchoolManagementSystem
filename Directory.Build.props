<Project>
  <PropertyGroup>
    <UseSharedCompilation>false</UseSharedCompilation>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ProjectReference>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemDefinitionGroup>
</Project>
